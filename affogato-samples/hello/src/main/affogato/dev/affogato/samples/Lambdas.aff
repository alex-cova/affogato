package dev.affogato.samples

import java.util.function.Function
import java.util.function.Supplier

class LambdasSample {
    static func run() {
        var names = List<String>()
        names.add("affogato")
        names.add("mocha")
        names.add("flat white")

        for name in names {
            // Swift-style trailing closure with a named argument before it.
            let display = LambdasSample.map(value = name) { item -> item + "!" }
            println(display)
        }

        // No-parameter trailing closure (Supplier).
        let ready = LambdasSample.supply { "lambda ready" }
        println(ready)

        // Trailing closure in a return statement (see shout()).
        println(LambdasSample.shout("hi"))

        var counter = 0
        while counter < 3 {
            // The classic named-argument form still works (backward compatible).
            let label = LambdasSample.map(value = "step " + counter, mapper = text -> text + text)
            println(label)
            counter = counter + 1
        }
    }

    static String map(value: String, mapper: Function<String, String>) {
        return mapper.apply(value)
    }

    static String supply(factory: Supplier<String>) {
        return factory.get()
    }

    static String shout(word: String) {
        return LambdasSample.map(value = word) { item -> item + "???" }
    }
}
