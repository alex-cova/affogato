// ==========================================
// Records
// ==========================================

record Pair<First, Second>(first: First, second: Second) {}

record GGMLTensorEntry(
    mappedFile: MemorySegment,
    name: String,
    ggmlType: GGMLType,
    shape: int[],
    memorySegment: MemorySegment
) {}

record GGUFTensorInfo(
    name: String,
    dimensions: int[],
    ggmlType: GGMLType,
    offset: long
) {}

record Llama(
    configuration: Configuration,
    tokenizer: GemmaTokenizer,
    weights: Weights
) {
    func createNewState(): State {
        let state = State(configuration)
        state.latestToken = tokenizer.getSpecialTokens().get("<bos>")
        return state
    }
}

record PartialModel(
    modelFileName: String,
    model: Llama,
    tensorDataOffset: long,
    tensorInfos: Map<String, GGUFTensorInfo>,
    ropeFreqsSWA: Pair<float[], float[]>,
    ropeFreqsFull: Pair<float[], float[]>
) {}

record Message(role: Role, content: String) {}

record Role(name: String) {
    override func toString(): String {
        return name
    }

    static let SYSTEM = Role("system")
    static let USER = Role("user")
    static let MODEL = Role("model")
}

record Vocabulary(
    tokens: String[],
    scores: float[],
    tokenToIndex: Map<String, Integer>
) {
    init(vocabulary: String[], scores: float[]) {
        this.tokens = vocabulary
        this.scores = scores
        this.tokenToIndex = IntStream.range(0, vocabulary.length)
            .boxed()
            .collect(Collectors.toMap(i -> vocabulary[i], i -> i))
    }

    func get(tokenIndex: int): String {
        return tokens[tokenIndex]
    }

    func getIndex(token: String): OptionalInt {
        let value = tokenToIndex.get(token)
        return value != null ? OptionalInt.of(value) : OptionalInt.empty()
    }

    func size(): int {
        return tokens.length
    }

    func getScore(tokenIndex: int): float {
        return scores[tokenIndex]
    }
}

// ==========================================
// Interfaces
// ==========================================

interface Timer: AutoCloseable {
    override func close()

    static func log(label: String): Timer {
        return LogTimer(label, TimeUnit.MILLISECONDS)
    }

    static func log(label: String, timeUnit: TimeUnit): Timer {
        return LogTimer(label, timeUnit)
    }
}

interface Sampler {
    func sampleToken(logits: FloatTensor): int
}

// ==========================================
// Enums
// ==========================================

enum MetadataValueType {
    UINT8, INT8, UINT16, INT16, UINT32, INT32, FLOAT32, BOOL, STRING, ARRAY, UINT64, INT64, FLOAT64
}

func MetadataValueType.fromIndex(index: int): MetadataValueType {
    return MetadataValueType.values()[index]
}

// ==========================================
// Classes
// ==========================================

class LogTimer: Timer {
    let label: String
    let timeUnit: TimeUnit
    let startNanos: long

    init(label: String, timeUnit: TimeUnit) {
        this.label = label
        this.timeUnit = timeUnit
        this.startNanos = System.nanoTime()
    }

    override func close() {
        let elapsedNanos = System.nanoTime() - startNanos
        System.err.println(
            label +
            ": " +
            timeUnit.convert(elapsedNanos, TimeUnit.NANOSECONDS) +
            " " +
            timeUnit.toChronoUnit().name().toLowerCase()
        )
    }
}

class ArgmaxSampler: Sampler {
    override func sampleToken(logits: FloatTensor): int {
        return logits.argmax()
    }
}

class CategoricalSampler: Sampler {
    let rng: RandomGenerator

    init(rng: RandomGenerator) {
        this.rng = rng
    }

    override func sampleToken(logits: FloatTensor): int {
        let random0to1 = rng.nextFloat(1.0f)
        var cdf = 0.0f
        var i = 0
        while i < logits.size() {
            cdf = cdf + logits.getFloat(i)
            if random0to1 < cdf {
                return i
            }
            i = i + 1
        }
        return Math.toIntExact(logits.size()) - 1
    }
}

class ToppSampler: Sampler {
    let indices: int[]
    let topp: float
    let rng: RandomGenerator

    init(maxNumberOfElements: int, topp: float, rng: RandomGenerator) {
        this.indices = new int[maxNumberOfElements]
        this.topp = topp
        this.rng = rng
    }

    static func swap(array: int[], from: int, to: int) {
        let tmp = array[from]
        array[from] = array[to]
        array[to] = tmp
    }

    static func siftDown(
        array: int[],
        from: int,
        n: int,
        comparator: Comparator<Integer>
    ) {
        var prev = from
        var next = 0
        while (2 * prev + 1) < n {
            next = 2 * prev + 1
            let r = 2 * prev + 2
            if r < n && comparator.compare(array[r], array[next]) < 0 {
                next = r
            }
            if comparator.compare(array[next], array[prev]) < 0 {
                ToppSampler.swap(array, prev, next)
                prev = next
            } else {
                return
            }
        }
    }

    override func sampleToken(logits: FloatTensor): int {
        let comparator = Comparator.comparingDouble(
            (Integer i) -> logits.getFloat(i)
        ).reversed()

        let n = Math.toIntExact(logits.size())
        var head = 0
        var tail = n - 1
        let cutoff = (1.0f - topp) / (n - 1)
        
        var i = 0
        while i < indices.length {
            if logits.getFloat(i) >= cutoff {
                indices[head] = i
                head = head + 1
            } else {
                indices[tail] = i
                tail = tail - 1
            }
            i = i + 1
        }

        let n0 = head
        i = n0 / 2 - 1
        while i >= 0 {
            ToppSampler.siftDown(indices, i, n0, comparator)
            i = i - 1
        }

        var cumulativeProb = 0.0f
        var lastIndex = 0
        i = n0 - 1
        while i >= 0 {
            ToppSampler.swap(indices, 0, i)
            cumulativeProb = cumulativeProb + logits.getFloat(indices[i])
            if cumulativeProb > topp {
                lastIndex = i
                break
            }
            ToppSampler.siftDown(indices, 0, i, comparator)
            i = i - 1
        }

        let r = rng.nextFloat(1.0f) * cumulativeProb
        var cdf = 0.0f
        i = n0 - 1
        while i >= lastIndex {
            cdf = cdf + logits.getFloat(indices[i])
            if r < cdf {
                return indices[i]
            }
            i = i - 1
        }

        return indices[lastIndex]
    }
}

class GGUF {
    private static let GGUF_MAGIC = 0x46554747
    private static let DEFAULT_ALIGNMENT = 32
    private static let PARSE_BUFFER_SIZE = 1 << 20
    private static let SUPPORTED_GGUF_VERSIONS: List<Integer> = List.of(2, 3)

    private var magic: int = 0
    private var version: int = 0
    private var tensorCount: int = 0
    private var alignment: int = 0
    private var metadata_kv_count: int = 0
    private var metadata: Map<String, Object> = null
    private var tensorInfos: Map<String, GGUFTensorInfo> = null
    private var tensorDataOffset: long = 0L

    func getMetadata(): Map<String, Object> {
        return metadata
    }

    func getTensorDataOffset(): long {
        return tensorDataOffset
    }

    func getTensorInfos(): Map<String, GGUFTensorInfo> {
        return tensorInfos
    }

    static func loadTensors(
        fileChannel: FileChannel,
        tensorDataOffset: long,
        tensorInfos: Map<String, GGUFTensorInfo>
    ): Map<String, GGMLTensorEntry> {
        let arena = Arena.global()
        let tensorData = fileChannel.map(
            FileChannel.MapMode.READ_ONLY,
            tensorDataOffset,
            fileChannel.size() - tensorDataOffset,
            arena
        )
        let tensorEntries: Map<String, GGMLTensorEntry> = HashMap.newHashMap(
            tensorInfos.size()
        )
        for entry in tensorInfos.entrySet() {
            let ti = entry.getValue()
            let numberOfElements = FloatTensor.numberOfElementsLong(
                ti.dimensions()
            )
            let sizeInBytes = ti.ggmlType().byteSizeFor(numberOfElements)
            let memorySegment = tensorData.asSlice(
                ti.offset(),
                sizeInBytes
            )
            tensorEntries.put(
                ti.name(),
                GGMLTensorEntry(
                    tensorData,
                    ti.name(),
                    ti.ggmlType(),
                    ti.dimensions(),
                    memorySegment
                )
            )
        }
        return tensorEntries
    }

    static func loadModel(modelPath: Path): GGUF {
        let fileChannel = FileChannel.open(modelPath)
        try {
            return GGUF.loadModel(fileChannel, modelPath.toString())
        } finally {
            fileChannel.close()
        }
    }

    static func loadModel(fileChannel: FileChannel, modelLabel: String): GGUF {
        let timer = Timer.log("Parse " + modelLabel)
        try {
            fileChannel.position(0L)
            let gguf = GGUF()
            let reader = ChannelReader(
                fileChannel,
                PARSE_BUFFER_SIZE
            )
            gguf.loadModelImpl(reader)
            return gguf
        } finally {
            timer.close()
        }
    }

    private func loadModelImpl(reader: ChannelReader) {
        readHeader(reader)
        this.tensorInfos = HashMap.newHashMap(tensorCount)
        var i = 0
        while i < tensorCount {
            let ti = readTensorInfo(reader)
            assert !tensorInfos.containsKey(ti.name())
            tensorInfos.put(ti.name(), ti)
            i = i + 1
        }
        let position = reader.position()
        let padding = (int) ((getAlignment() - (position % getAlignment())) %
            getAlignment())
        skipBytes(reader, padding)
        this.tensorDataOffset = reader.position()
    }

    private func readGGMLType(reader: ChannelReader): GGMLType {
        let ggmlTypeId = readInt(reader)
        return GGMLType.fromId(ggmlTypeId)
    }

    private func readTensorInfo(reader: ChannelReader): GGUFTensorInfo {
        let name = readString(reader)
        assert name.length() <= 64
        let n_dimensions = readInt(reader)
        assert n_dimensions <= 4
        let dimensions = new int[n_dimensions]
        var i = 0
        while i < n_dimensions {
            dimensions[i] = Math.toIntExact(readLong(reader))
            i = i + 1
        }
        let ggmlType = readGGMLType(reader)
        let offset = readLong(reader)
        assert offset % getAlignment() == 0
        return GGUFTensorInfo(name, dimensions, ggmlType, offset)
    }

    private func readString(reader: ChannelReader): String {
        let len = Math.toIntExact(readLong(reader))
        return String(readBytes(reader, len), StandardCharsets.UTF_8)
    }

    private func readKeyValuePair(reader: ChannelReader): Pair<String, Object> {
        let key = readString(reader)
        assert key.length() < (1 << 16)
        assert key
            .codePoints()
            .allMatch(
                cp ->
                    ('a' <= cp && cp <= 'z') ||
                    ('0' <= cp && cp <= '9') ||
                    cp == '_' ||
                    cp == '.'
            )
        let value = readMetadataValue(reader)
        return Pair(key, value)
    }

    private func readMetadataValue(reader: ChannelReader): Object {
        let valueType = readMetadataValueType(reader)
        return readMetadataValueOfType(valueType, reader)
    }

    func readHeader(reader: ChannelReader) {
        this.magic = readInt(reader)
        if magic != GGUF_MAGIC {
            throw IllegalArgumentException("unsupported header.magic " + magic)
        }
        this.version = readInt(reader)
        if !SUPPORTED_GGUF_VERSIONS.contains(version) {
            throw IllegalArgumentException("unsupported header.version " + version)
        }
        this.tensorCount = Math.toIntExact(readLong(reader))
        this.metadata_kv_count = Math.toIntExact(readLong(reader))
        this.metadata = HashMap.newHashMap(metadata_kv_count)
        var i = 0
        while i < metadata_kv_count {
            let keyValue = readKeyValuePair(reader)
            assert !metadata.containsKey(keyValue.first())
            metadata.put(keyValue.first(), keyValue.second())
            i = i + 1
        }
    }

    private func readArray(reader: ChannelReader): Object {
        let valueType = readMetadataValueType(reader)
        let len = Math.toIntExact(readLong(reader))
        
        switch valueType {
            case MetadataValueType.UINT8, MetadataValueType.INT8 -> {
                return readBytes(reader, len)
            }
            case MetadataValueType.UINT16, MetadataValueType.INT16 -> {
                let shorts = new short[len]
                var i = 0
                while i < len {
                    shorts[i] = readShort(reader)
                    i = i + 1
                }
                return shorts
            }
            case MetadataValueType.UINT32, MetadataValueType.INT32 -> {
                let ints = new int[len]
                var i = 0
                while i < len {
                    ints[i] = readInt(reader)
                    i = i + 1
                }
                return ints
            }
            case MetadataValueType.FLOAT32 -> {
                let floats = new float[len]
                var i = 0
                while i < len {
                    floats[i] = readFloat(reader)
                    i = i + 1
                }
                return floats
            }
            case MetadataValueType.BOOL -> {
                let booleans = new boolean[len]
                var i = 0
                while i < len {
                    booleans[i] = readBoolean(reader)
                    i = i + 1
                }
                return booleans
            }
            case MetadataValueType.STRING -> {
                let strings = new String[len]
                var i = 0
                while i < len {
                    strings[i] = readString(reader)
                    i = i + 1
                }
                return strings
            }
            case MetadataValueType.ARRAY -> {
                let arrays = new Object[len]
                var i = 0
                while i < len {
                    arrays[i] = readArray(reader)
                    i = i + 1
                }
                return arrays
            }
            default -> {
                throw UnsupportedOperationException("read array of " + valueType)
            }
        }
    }

    private func readMetadataValueOfType(
        valueType: MetadataValueType,
        reader: ChannelReader
    ): Object {
        switch valueType {
            case MetadataValueType.UINT8, MetadataValueType.INT8 -> { return readByte(reader) }
            case MetadataValueType.UINT16, MetadataValueType.INT16 -> { return readShort(reader) }
            case MetadataValueType.UINT32, MetadataValueType.INT32 -> { return readInt(reader) }
            case MetadataValueType.FLOAT32 -> { return readFloat(reader) }
            case MetadataValueType.UINT64, MetadataValueType.INT64 -> { return readLong(reader) }
            case MetadataValueType.FLOAT64 -> { return readDouble(reader) }
            case MetadataValueType.BOOL -> { return readBoolean(reader) }
            case MetadataValueType.STRING -> { return readString(reader) }
            case MetadataValueType.ARRAY -> { return readArray(reader) }
        }
    }

    private func readMetadataValueType(reader: ChannelReader): MetadataValueType {
        let index = readInt(reader)
        return MetadataValueType.fromIndex(index)
    }

    private func readBytes(reader: ChannelReader, length: int): byte[] {
        return reader.readBytes(length)
    }

    private func skipBytes(reader: ChannelReader, length: int) {
        reader.skipBytes(length)
    }

    private func readByte(reader: ChannelReader): byte {
        return reader.readByte()
    }

    private func readBoolean(reader: ChannelReader): boolean {
        return readByte(reader) != (byte) 0
    }

    private func readShort(reader: ChannelReader): short {
        return reader.readShort()
    }

    private func readInt(reader: ChannelReader): int {
        return reader.readInt()
    }

    private func readLong(reader: ChannelReader): long {
        return reader.readLong()
    }

    private func readFloat(reader: ChannelReader): float {
        return reader.readFloat()
    }

    private func readDouble(reader: ChannelReader): double {
        return reader.readDouble()
    }

    func getAlignment(): int {
        if alignment != 0 {
            return alignment
        }
        alignment = (int) metadata.getOrDefault(
            "general.alignment",
            DEFAULT_ALIGNMENT
        )
        assert Integer.bitCount(alignment) == 1 : "alignment must be a power of two"
        return alignment
    }
}

class ChannelReader {
    private let channel: ReadableByteChannel
    private let buffer: ByteBuffer
    private var position: long = 0L

    init(channel: ReadableByteChannel, bufferSize: int) {
        this.channel = channel
        this.buffer = ByteBuffer.allocateDirect(bufferSize).order(
            ByteOrder.LITTLE_ENDIAN
        )
        this.buffer.limit(0)
        this.position = 0L
    }

    func position(): long {
        return position
    }

    private func ensure(required: int) {
        if required > buffer.capacity() {
            throw IllegalArgumentException(
                "Requested read " +
                required +
                " exceeds buffer capacity " +
                buffer.capacity()
            )
        }
        if buffer.remaining() >= required {
            return
        }
        buffer.compact()
        while buffer.position() < required {
            let read = channel.read(buffer)
            if read < 0 {
                throw IOException("Unexpected EOF while reading GGUF metadata")
            }
        }
        buffer.flip()
    }

    func readByte(): byte {
        ensure(Byte.BYTES)
        position = position + Byte.BYTES
        return buffer.get()
    }

    func readShort(): short {
        ensure(Short.BYTES)
        position = position + Short.BYTES
        return buffer.getShort()
    }

    func readInt(): int {
        ensure(Integer.BYTES)
        position = position + Integer.BYTES
        return buffer.getInt()
    }

    func readLong(): long {
        ensure(Long.BYTES)
        position = position + Long.BYTES
        return buffer.getLong()
    }

    func readFloat(): float {
        return Float.intBitsToFloat(readInt())
    }

    func readDouble(): double {
        return Double.longBitsToDouble(readLong())
    }

    func readBytes(length: int): byte[] {
        let bytes = new byte[length]
        var copied = 0
        while copied < length {
            if !buffer.hasRemaining() {
                ensure(1)
            }
            let chunk = Math.min(length - copied, buffer.remaining())
            buffer.get(bytes, copied, chunk)
            copied = copied + chunk
            position = position + chunk
        }
        return bytes
    }

    func skipBytes(length: int) {
        var remaining = length
        while remaining > 0 {
            if !buffer.hasRemaining() {
                ensure(1)
            }
            let chunk = Math.min(remaining, buffer.remaining())
            buffer.position(buffer.position() + chunk)
            remaining = remaining - chunk
            position = position + chunk
        }
    }
}

class ModelLoader {
    private static func loadVocabulary(metadata: Map<String, Object>): Vocabulary {
        let tokens = metadata.get("tokenizer.ggml.tokens") as String[]
        let scores = metadata.get("tokenizer.ggml.scores") as float[]
        return Vocabulary(tokens, scores)
    }

    static func loadModel(ggufPath: Path, contextLength: int): Llama {
        let timer = Timer.log("Load Gemma4 model")
        try {
            let fileChannel = FileChannel.open(ggufPath, StandardOpenOption.READ)
            try {
                let gguf = GGUF.loadModel(fileChannel, ggufPath.toString())
                return ModelLoader.loadModel(fileChannel, gguf, contextLength, true)
            } finally {
                fileChannel.close()
            }
        } finally {
            timer.close()
        }
    }

    static func loadModel(
        fileChannel: FileChannel,
        gguf: GGUF,
        contextLength: int,
        loadWeightsFlag: boolean
    ): Llama {
        let metadata = gguf.getMetadata()
        let vocabulary = loadVocabulary(metadata)
        let tokenizer = createTokenizer(metadata, vocabulary)

        var modelContextLength = (int) metadata.get("gemma4.context_length")
        var realContextLength = contextLength
        if realContextLength < 0 || modelContextLength < realContextLength {
            realContextLength = modelContextLength
        }

        let embeddingLength = (int) metadata.get("gemma4.embedding_length")
        let numberOfHeads = (int) metadata.get("gemma4.attention.head_count")
        let numberOfLayers = (int) metadata.get("gemma4.block_count")

        let headSizeFull = (int) metadata.get("gemma4.attention.key_length")
        let headSizeSWA = (int) metadata.get("gemma4.attention.key_length_swa")
        let slidingWindow = (int) metadata.get("gemma4.attention.sliding_window")
        
        let logitSoftcapping = metadata.containsKey("gemma4.final_logit_softcapping")
            ? (float) metadata.get("gemma4.final_logit_softcapping")
            : 0.0f
        
        let rmsNormEps = metadata.containsKey("gemma4.attention.layer_norm_rms_epsilon")
            ? (float) metadata.get("gemma4.attention.layer_norm_rms_epsilon")
            : 1e-6f

        let ropeTheta = metadata.containsKey("gemma4.rope.freq_base")
            ? (float) metadata.get("gemma4.rope.freq_base")
            : 1000000.0f

        let ropeThetaSWA = metadata.containsKey("gemma4.rope.freq_base_swa")
            ? (float) metadata.get("gemma4.rope.freq_base_swa")
            : 10000.0f

        // MoE parameters
        let expertCount = metadata.containsKey("gemma4.expert_count")
            ? (int) metadata.get("gemma4.expert_count")
            : 0
        let expertUsedCount = metadata.containsKey("gemma4.expert_used_count")
            ? (int) metadata.get("gemma4.expert_used_count")
            : 0
        let expertFeedForwardLength = metadata.containsKey("gemma4.expert_feed_forward_length")
            ? (int) metadata.get("gemma4.expert_feed_forward_length")
            : 0

        // Per-layer feed forward lengths
        var feedForwardLength: int[] = null
        let ffnRaw = metadata.get("gemma4.feed_forward_length")
        if ffnRaw is int[] {
            feedForwardLength = ffnRaw as int[]
        } else {
            feedForwardLength = new int[numberOfLayers]
            Arrays.fill(feedForwardLength, (int) ffnRaw)
        }

        let tensorInfos = gguf.getTensorInfos()

        // Derive isSWA per layer
        var isSWA: boolean[] = null
        let swaRaw = metadata.get("gemma4.attention.sliding_window_pattern")
        if swaRaw is boolean[] {
            isSWA = swaRaw as boolean[]
        } else {
            isSWA = new boolean[numberOfLayers]
            var i = 0
            while i < numberOfLayers {
                let qNorm = tensorInfos.get("blk." + i + ".attn_q_norm.weight")
                if qNorm != null {
                    let qNormSize = FloatTensor.numberOfElementsLong(
                        qNorm.dimensions()
                    )
                    isSWA[i] = (qNormSize == (long) headSizeSWA)
                } else {
                    isSWA[i] = (i % 5 != 4)
                }
                i = i + 1
            }
        }

        // Derive per-layer KV head count
        let numberOfKeyValueHeadsPerLayer = new int[numberOfLayers]
        var i = 0
        while i < numberOfLayers {
            let kWeight = tensorInfos.get("blk." + i + ".attn_k.weight")
            let headSize = isSWA[i] ? headSizeSWA : headSizeFull
            if kWeight != null {
                let kDim = kWeight.dimensions()[1]
                numberOfKeyValueHeadsPerLayer[i] = (int) (kDim / headSize)
            } else {
                numberOfKeyValueHeadsPerLayer[i] = numberOfHeads
            }
            i = i + 1
        }

        // Shared KV layers
        let sharedKvLayers = metadata.containsKey("gemma4.attention.shared_kv_layers")
            ? (int) metadata.get("gemma4.attention.shared_kv_layers")
            : 0
        let nLayerKvFromStart = numberOfLayers - sharedKvLayers

        let embeddingLengthPerLayer = metadata.containsKey("gemma4.embedding_length_per_layer_input")
            ? (int) metadata.get("gemma4.embedding_length_per_layer_input")
            : 0

        let config = Configuration(
            embeddingLength,
            feedForwardLength,
            numberOfLayers,
            numberOfHeads,
            numberOfKeyValueHeadsPerLayer,
            vocabulary.size(),
            realContextLength,
            rmsNormEps,
            ropeTheta,
            ropeThetaSWA,
            headSizeFull,
            headSizeSWA,
            slidingWindow,
            logitSoftcapping,
            isSWA,
            nLayerKvFromStart,
            embeddingLengthPerLayer,
            expertCount,
            expertUsedCount,
            expertFeedForwardLength
        )

        if not(loadWeightsFlag) {
            return Llama(config, tokenizer, null)
        }

        let tensorEntries = GGUF.loadTensors(
            fileChannel,
            gguf.getTensorDataOffset(),
            tensorInfos
        )
        let qw = ModelLoader.loadWeights(tensorEntries, config)
        return Llama(config, tokenizer, qw)
    }

    static func loadWeights(
        tensorEntries: Map<String, GGMLTensorEntry>,
        config: Configuration
    ): Weights {
        let ropeFreqsSWA = RoPE.precomputeFreqsCis(
            config.contextLength,
            config.headSizeSWA,
            config.ropeThetaSWA
        )
        let ropeFreqsBuf = ModelLoader.toFloatBuffer(
            tensorEntries.get("rope_freqs.weight")
        )
        let modelRopeFreqs = new float[ropeFreqsBuf.remaining()]
        ropeFreqsBuf.get(modelRopeFreqs)
        let ropeFreqsFull = RoPE.precomputeFreqsCisFromFreqs(
            config.contextLength,
            config.headSizeFull,
            config.ropeTheta,
            modelRopeFreqs
        )
        return ModelLoader.loadWeightsWithRoPE(
            tensorEntries,
            config,
            ropeFreqsSWA,
            ropeFreqsFull
        )
    }

    static func loadWeightsWithRoPE(
        tensorEntries: Map<String, GGMLTensorEntry>,
        config: Configuration,
        ropeFreqsSWA: Pair<float[], float[]>,
        ropeFreqsFull: Pair<float[], float[]>
    ): Weights {
        let numberOfLayers = config.numberOfLayers

        let tokenEmbeddingTable = ModelLoader.loadQuantized(
            tensorEntries.get("token_embd.weight")
        )

        let layerOutputScale = new float[config.numberOfLayers]
        var i = 0
        while i < config.numberOfLayers {
            let scaleEntry = tensorEntries.get(
                "blk." + i + ".layer_output_scale.weight"
            )
            if scaleEntry != null {
                layerOutputScale[i] = ModelLoader.toFloatBuffer(scaleEntry).get(0)
            } else {
                layerOutputScale[i] = 1.0f
            }
            i = i + 1
        }

        var perLayerTokenEmbd: FloatTensor = null
        var perLayerModelProj: FloatTensor = null
        var perLayerProjNorm: FloatBuffer = null
        var perLayerInpGate: FloatTensor[] = null
        var perLayerProj: FloatTensor[] = null
        var perLayerPostNorm: FloatBuffer[] = null

        if config.embeddingLengthPerLayer > 0 && tensorEntries.containsKey("per_layer_token_embd.weight") {
            perLayerTokenEmbd = ModelLoader.loadQuantized(
                tensorEntries.get("per_layer_token_embd.weight")
            )
            perLayerModelProj = ModelLoader.loadQuantized(
                tensorEntries.get("per_layer_model_proj.weight")
            )
            perLayerProjNorm = ModelLoader.toFloatBuffer(
                tensorEntries.get("per_layer_proj_norm.weight")
            )
            perLayerInpGate = ModelLoader.loadArrayOfQuantized(config.numberOfLayers, idx ->
                tensorEntries.get("blk." + idx + ".inp_gate.weight")
            )
            perLayerProj = ModelLoader.loadArrayOfQuantized(config.numberOfLayers, idx ->
                tensorEntries.get("blk." + idx + ".proj.weight")
            )
            perLayerPostNorm = ModelLoader.loadArrayOfFloatBuffer(
                config.numberOfLayers,
                idx -> tensorEntries.get("blk." + idx + ".post_norm.weight")
            )
        }

        let wv = new FloatTensor[numberOfLayers]
        i = 0
        while i < numberOfLayers {
            let vEntry = tensorEntries.get(
                "blk." + i + ".attn_v.weight"
            )
            wv[i] = vEntry != null ? ModelLoader.loadQuantized(vEntry) : null
            i = i + 1
        }

        var ffnGateInp: FloatTensor[] = null
        var ffnGateInpScale: FloatBuffer[] = null
        var ffnGateUpExps: FloatTensor[] = null
        var ffnDownExps: FloatTensor[] = null
        var ffnDownExpsScale: FloatBuffer[] = null
        var ffnPostNorm1: FloatBuffer[] = null
        var preFfwNorm2: FloatBuffer[] = null
        var ffnPostNorm2: FloatBuffer[] = null

        if config.isMoE() {
            ffnGateInp = ModelLoader.loadArrayOfQuantized(numberOfLayers, idx ->
                tensorEntries.get("blk." + idx + ".ffn_gate_inp.weight")
            )
            ffnGateInpScale = ModelLoader.loadArrayOfFloatBuffer(numberOfLayers, idx ->
                tensorEntries.get("blk." + idx + ".ffn_gate_inp.scale")
            )
            ffnGateUpExps = ModelLoader.loadArrayOfQuantized(numberOfLayers, idx ->
                tensorEntries.get("blk." + idx + ".ffn_gate_up_exps.weight")
            )
            ffnDownExps = ModelLoader.loadArrayOfQuantized(numberOfLayers, idx ->
                tensorEntries.get("blk." + idx + ".ffn_down_exps.weight")
            )
            ffnDownExpsScale = ModelLoader.loadArrayOfFloatBuffer(numberOfLayers, idx ->
                tensorEntries.get("blk." + idx + ".ffn_down_exps.scale")
            )
            ffnPostNorm1 = ModelLoader.loadArrayOfFloatBuffer(numberOfLayers, idx ->
                tensorEntries.get("blk." + idx + ".post_ffw_norm_1.weight")
            )
            preFfwNorm2 = ModelLoader.loadArrayOfFloatBuffer(numberOfLayers, idx ->
                tensorEntries.get("blk." + idx + ".pre_ffw_norm_2.weight")
            )
            ffnPostNorm2 = ModelLoader.loadArrayOfFloatBuffer(numberOfLayers, idx ->
                tensorEntries.get("blk." + idx + ".post_ffw_norm_2.weight")
            )
        }

        let outWeightEntry = tensorEntries.get("output.weight")
        let wcls = outWeightEntry != null
            ? ModelLoader.loadQuantized(outWeightEntry)
            : tokenEmbeddingTable

        return Weights(
            tokenEmbeddingTable,
            ModelLoader.loadArrayOfFloatBuffer(config.numberOfLayers, idx ->
                tensorEntries.get("blk." + idx + ".attn_norm.weight")
            ),
            ModelLoader.loadArrayOfQuantized(config.numberOfLayers, idx ->
                tensorEntries.get("blk." + idx + ".attn_q.weight")
            ),
            ModelLoader.loadArrayOfQuantized(config.numberOfLayers, idx ->
                tensorEntries.get("blk." + idx + ".attn_k.weight")
            ),
            wv,
            ModelLoader.loadArrayOfQuantized(config.numberOfLayers, idx ->
                tensorEntries.get("blk." + idx + ".attn_output.weight")
            ),
            ModelLoader.loadArrayOfFloatBuffer(config.numberOfLayers, idx ->
                tensorEntries.get("blk." + idx + ".attn_q_norm.weight")
            ),
            ModelLoader.loadArrayOfFloatBuffer(config.numberOfLayers, idx ->
                tensorEntries.get("blk." + idx + ".attn_k_norm.weight")
            ),
            ModelLoader.loadArrayOfFloatBuffer(config.numberOfLayers, idx ->
                tensorEntries.get("blk." + idx + ".post_attention_norm.weight")
            ),
            ModelLoader.loadArrayOfFloatBuffer(config.numberOfLayers, idx ->
                tensorEntries.get("blk." + idx + ".ffn_norm.weight")
            ),
            ModelLoader.loadArrayOfQuantized(config.numberOfLayers, idx ->
                tensorEntries.get("blk." + idx + ".ffn_gate.weight")
            ),
            ModelLoader.loadArrayOfQuantized(config.numberOfLayers, idx ->
                tensorEntries.get("blk." + idx + ".ffn_down.weight")
            ),
            ModelLoader.loadArrayOfQuantized(config.numberOfLayers, idx ->
                tensorEntries.get("blk." + idx + ".ffn_up.weight")
            ),
            ModelLoader.loadArrayOfFloatBuffer(config.numberOfLayers, idx ->
                tensorEntries.get("blk." + idx + ".post_ffw_norm.weight")
            ),
            ModelLoader.toFloatBuffer(tensorEntries.get("output_norm.weight")),
            layerOutputScale,
            FloatBuffer.wrap(ropeFreqsFull.first()),
            FloatBuffer.wrap(ropeFreqsFull.second()),
            FloatBuffer.wrap(ropeFreqsSWA.first()),
            FloatBuffer.wrap(ropeFreqsSWA.second()),
            wcls,
            perLayerTokenEmbd,
            perLayerModelProj,
            perLayerProjNorm,
            perLayerInpGate,
            perLayerProj,
            perLayerPostNorm,
            ffnGateInp,
            ffnGateInpScale,
            ffnGateUpExps,
            ffnDownExps,
            ffnDownExpsScale,
            ffnPostNorm1,
            preFfwNorm2,
            ffnPostNorm2
        )
    }

    private static func createTokenizer(
        metadata: Map<String, Object>,
        vocabulary: Vocabulary
    ): GemmaTokenizer {
        let tokenTypes = metadata.get("tokenizer.ggml.token_type") as int[]
        return GemmaTokenizer(vocabulary, tokenTypes)
    }

    static func loadQuantized(entry: GGMLTensorEntry): FloatTensor {
        let ggmlType = entry.ggmlType()
        let numElements = FloatTensor.numberOfElementsLong(entry.shape())
        if ggmlType == GGMLType.Q8_0 {
            return Q8_0FloatTensor(numElements, entry.memorySegment())
        }
        if ggmlType == GGMLType.Q4_0 {
            return Q4_0FloatTensor(numElements, entry.memorySegment())
        }
        if ggmlType == GGMLType.Q4_1 {
            return Q4_1FloatTensor(numElements, entry.memorySegment())
        }
        if ggmlType == GGMLType.Q5_1 {
            return Q5_1FloatTensor(numElements, entry.memorySegment())
        }
        if ggmlType == GGMLType.Q4_K {
            return Q4_KFloatTensor(numElements, entry.memorySegment())
        }
        if ggmlType == GGMLType.Q5_K {
            return Q5_KFloatTensor(numElements, entry.memorySegment())
        }
        if ggmlType == GGMLType.Q6_K {
            return Q6_KFloatTensor(numElements, entry.memorySegment())
        }
        if ggmlType == GGMLType.F32 {
            return F32FloatTensor(numElements, entry.memorySegment())
        }
        if ggmlType == GGMLType.F16 {
            return F16FloatTensor(numElements, entry.memorySegment())
        }
        if ggmlType == GGMLType.BF16 {
            return BF16FloatTensor(numElements, entry.memorySegment())
        }
        if ggmlType == GGMLType.MXFP4 {
            return MXFP4FloatTensor(numElements, entry.memorySegment())
        }
        throw UnsupportedOperationException("Quantization format " + ggmlType)
    }

    static func loadArrayOfQuantized(
        size: int,
        getTensorEntry: IntFunction<GGMLTensorEntry>
    ): FloatTensor[] {
        let array = new FloatTensor[size]
        var i = 0
        while i < size {
            array[i] = ModelLoader.loadQuantized(getTensorEntry.apply(i))
            i = i + 1
        }
        return array
    }

    static func loadArrayOfFloatBuffer(
        size: int,
        getTensorEntry: IntFunction<GGMLTensorEntry>
    ): FloatBuffer[] {
        let array = new FloatBuffer[size]
        var i = 0
        while i < size {
            array[i] = ModelLoader.toFloatBuffer(getTensorEntry.apply(i))
            i = i + 1
        }
        return array
    }

    static func toFloatBuffer(tensorEntry: GGMLTensorEntry): FloatBuffer {
        let ggmlType = tensorEntry.ggmlType()
        if ggmlType == GGMLType.F32 {
            return tensorEntry
                .memorySegment()
                .asByteBuffer()
                .order(ByteOrder.LITTLE_ENDIAN)
                .asFloatBuffer()
        }
        throw UnsupportedOperationException("Conversion to " + ggmlType)
    }
}

class Configuration {
    let embeddingLength: int
    let feedForwardLength: int[]
    let numberOfLayers: int
    let numberOfHeads: int
    let numberOfKeyValueHeadsPerLayer: int[]
    let vocabularySize: int
    let contextLength: int
    let rmsNormEps: float
    let ropeTheta: float
    let ropeThetaSWA: float
    let headSizeFull: int
    let headSizeSWA: int
    let slidingWindow: int
    let logitSoftcapping: float
    let isSWA: boolean[]
    let nLayerKvFromStart: int
    let embeddingLengthPerLayer: int
    let expertCount: int
    let expertUsedCount: int
    let expertFeedForwardLength: int

    init(
        embeddingLength: int,
        feedForwardLength: int[],
        numberOfLayers: int,
        numberOfHeads: int,
        numberOfKeyValueHeadsPerLayer: int[],
        vocabularySize: int,
        contextLength: int,
        rmsNormEps: float,
        ropeTheta: float,
        ropeThetaSWA: float,
        headSizeFull: int,
        headSizeSWA: int,
        slidingWindow: int,
        logitSoftcapping: float,
        isSWA: boolean[],
        nLayerKvFromStart: int,
        embeddingLengthPerLayer: int,
        expertCount: int,
        expertUsedCount: int,
        expertFeedForwardLength: int
    ) {
        if slidingWindow <= 0 || Integer.bitCount(slidingWindow) != 1 {
            throw IllegalArgumentException(
                "slidingWindow must be a power of 2, got " + slidingWindow
            )
        }
        this.embeddingLength = embeddingLength
        this.feedForwardLength = feedForwardLength
        this.numberOfLayers = numberOfLayers
        this.numberOfHeads = numberOfHeads
        this.numberOfKeyValueHeadsPerLayer = numberOfKeyValueHeadsPerLayer
        this.vocabularySize = vocabularySize
        this.contextLength = contextLength
        this.rmsNormEps = rmsNormEps
        this.ropeTheta = ropeTheta
        this.ropeThetaSWA = ropeThetaSWA
        this.headSizeFull = headSizeFull
        this.headSizeSWA = headSizeSWA
        this.slidingWindow = slidingWindow
        this.logitSoftcapping = logitSoftcapping
        this.isSWA = isSWA
        this.nLayerKvFromStart = nLayerKvFromStart
        this.embeddingLengthPerLayer = embeddingLengthPerLayer
        this.expertCount = expertCount
        this.expertUsedCount = expertUsedCount
        this.expertFeedForwardLength = expertFeedForwardLength
    }

    func isMoE(): boolean {
        return expertCount > 0
    }

    func kvSourceLayer(layer: int): int {
        if layer < nLayerKvFromStart {
            return layer
        }
        let subtract = isSWA[layer] ? 2 : 1
        return nLayerKvFromStart - subtract
    }

    func hasKv(layer: int): boolean {
        return layer < nLayerKvFromStart
    }

    func headSize(layer: int): int {
        return isSWA[layer] ? headSizeSWA : headSizeFull
    }

    func numberOfKeyValueHeads(layer: int): int {
        return numberOfKeyValueHeadsPerLayer[layer]
    }

    func kvCachePositions(layer: int): int {
        return isSWA[layer]
            ? Math.min(contextLength, slidingWindow)
            : contextLength
    }

    func kvCacheIndex(layer: int, position: int): int {
        return isSWA[layer] ? (position & (slidingWindow - 1)) : position
    }

    func kvDim(layer: int): int {
        return numberOfKeyValueHeadsPerLayer[layer] * headSize(layer)
    }

    func queryDim(layer: int): int {
        return numberOfHeads * headSize(layer)
    }

    func maxHiddenDim(): int {
        return Arrays.stream(feedForwardLength).max().orElseThrow()
    }

    func withContextLength(newContextLength: int): Configuration {
        return Configuration(
            embeddingLength,
            feedForwardLength,
            numberOfLayers,
            numberOfHeads,
            numberOfKeyValueHeadsPerLayer,
            vocabularySize,
            newContextLength,
            rmsNormEps,
            ropeTheta,
            ropeThetaSWA,
            headSizeFull,
            headSizeSWA,
            slidingWindow,
            logitSoftcapping,
            isSWA,
            nLayerKvFromStart,
            embeddingLengthPerLayer,
            expertCount,
            expertUsedCount,
            expertFeedForwardLength
        )
    }
}

class Weights {
    let token_embedding_table: FloatTensor
    let rms_att_weight: FloatBuffer[]
    let wq: FloatTensor[]
    let wk: FloatTensor[]
    let wv: FloatTensor[]
    let wo: FloatTensor[]
    let attn_q_norm: FloatBuffer[]
    let attn_k_norm: FloatBuffer[]
    let post_attention_norm: FloatBuffer[]
    let rms_ffn_weight: FloatBuffer[]
    let w1: FloatTensor[]
    let w2: FloatTensor[]
    let w3: FloatTensor[]
    let post_ffw_norm: FloatBuffer[]
    let rms_final_weight: FloatBuffer
    let layerOutputScale: float[]
    let freq_cis_real_full: FloatBuffer
    let freq_cis_imag_full: FloatBuffer
    let freq_cis_real_swa: FloatBuffer
    let freq_cis_imag_swa: FloatBuffer
    let wcls: FloatTensor
    let perLayerTokenEmbd: FloatTensor
    let perLayerModelProj: FloatTensor
    let perLayerProjNorm: FloatBuffer
    let perLayerInpGate: FloatTensor[]
    let perLayerProj: FloatTensor[]
    let perLayerPostNorm: FloatBuffer[]
    let ffnGateInp: FloatTensor[]
    let ffnGateInpScale: FloatBuffer[]
    let ffnGateUpExps: FloatTensor[]
    let ffnDownExps: FloatTensor[]
    let ffnDownExpsScale: FloatBuffer[]
    let ffnPostNorm1: FloatBuffer[]
    let preFfwNorm2: FloatBuffer[]
    let ffnPostNorm2: FloatBuffer[]

    init(
        token_embedding_table: FloatTensor,
        rms_att_weight: FloatBuffer[],
        wq: FloatTensor[],
        wk: FloatTensor[],
        wv: FloatTensor[],
        wo: FloatTensor[],
        attn_q_norm: FloatBuffer[],
        attn_k_norm: FloatBuffer[],
        post_attention_norm: FloatBuffer[],
        rms_ffn_weight: FloatBuffer[],
        w1: FloatTensor[],
        w2: FloatTensor[],
        w3: FloatTensor[],
        post_ffw_norm: FloatBuffer[],
        rms_final_weight: FloatBuffer,
        layerOutputScale: float[],
        freq_cis_real_full: FloatBuffer,
        freq_cis_imag_full: FloatBuffer,
        freq_cis_real_swa: FloatBuffer,
        freq_cis_imag_swa: FloatBuffer,
        wcls: FloatTensor,
        perLayerTokenEmbd: FloatTensor,
        perLayerModelProj: FloatTensor,
        perLayerProjNorm: FloatBuffer,
        perLayerInpGate: FloatTensor[],
        perLayerProj: FloatTensor[],
        perLayerPostNorm: FloatBuffer[],
        ffnGateInp: FloatTensor[],
        ffnGateInpScale: FloatBuffer[],
        ffnGateUpExps: FloatTensor[],
        ffnDownExps: FloatTensor[],
        ffnDownExpsScale: FloatBuffer[],
        ffnPostNorm1: FloatBuffer[],
        preFfwNorm2: FloatBuffer[],
        ffnPostNorm2: FloatBuffer[]
    ) {
        this.token_embedding_table = token_embedding_table
        this.rms_att_weight = rms_att_weight
        this.wq = wq
        this.wk = wk
        this.wv = wv
        this.wo = wo
        this.attn_q_norm = attn_q_norm
        this.attn_k_norm = attn_k_norm
        this.post_attention_norm = post_attention_norm
        this.rms_ffn_weight = rms_ffn_weight
        this.w1 = w1
        this.w2 = w2
        this.w3 = w3
        this.post_ffw_norm = post_ffw_norm
        this.rms_final_weight = rms_final_weight
        this.layerOutputScale = layerOutputScale
        this.freq_cis_real_full = freq_cis_real_full
        this.freq_cis_imag_full = freq_cis_imag_full
        this.freq_cis_real_swa = freq_cis_real_swa
        this.freq_cis_imag_swa = freq_cis_imag_swa
        this.wcls = wcls
        this.perLayerTokenEmbd = perLayerTokenEmbd
        this.perLayerModelProj = perLayerModelProj
        this.perLayerProjNorm = perLayerProjNorm
        this.perLayerInpGate = perLayerInpGate
        this.perLayerProj = perLayerProj
        this.perLayerPostNorm = perLayerPostNorm
        this.ffnGateInp = ffnGateInp
        this.ffnGateInpScale = ffnGateInpScale
        this.ffnGateUpExps = ffnGateUpExps
        this.ffnDownExps = ffnDownExps
        this.ffnDownExpsScale = ffnDownExpsScale
        this.ffnPostNorm1 = ffnPostNorm1
        this.preFfwNorm2 = preFfwNorm2
        this.ffnPostNorm2 = ffnPostNorm2
    }
}

class State {
    let x: FloatTensor
    let xb: FloatTensor
    let xb_k: FloatTensor
    let xb2: FloatTensor
    let hb: FloatTensor
    let hb2: FloatTensor
    let q: FloatTensor
    let k: FloatTensor
    let v: FloatTensor
    let att: FloatTensor
    let logits: FloatTensor
    let keyCache: FloatTensor[]
    let valueCache: FloatTensor[]
    let perLayerInputs: FloatTensor
    let plGate: FloatTensor
    let plProj: FloatTensor
    let routerLogits: FloatTensor
    let moeInput: FloatTensor
    let moeOutput: FloatTensor
    let expertGateUp: FloatTensor
    let expertDown: FloatTensor
    var latestToken: int = 0

    init(config: Configuration) {
        let maxQueryDim = config.numberOfHeads * config.headSizeFull
        let maxKVDim = IntStream.range(0, config.numberOfLayers)
            .map(idx -> config.kvDim(idx))
            .max()
            .orElse(0)
        let maxHiddenDim = config.maxHiddenDim()
        
        this.x = ArrayFloatTensor.allocate(config.embeddingLength)
        this.xb = ArrayFloatTensor.allocate(config.embeddingLength)
        this.xb_k = ArrayFloatTensor.allocate(maxQueryDim)
        this.xb2 = ArrayFloatTensor.allocate(config.embeddingLength)
        this.hb = ArrayFloatTensor.allocate(maxHiddenDim)
        this.hb2 = ArrayFloatTensor.allocate(maxHiddenDim)
        this.q = ArrayFloatTensor.allocate(maxQueryDim)
        this.k = ArrayFloatTensor.allocate(maxKVDim)
        this.v = ArrayFloatTensor.allocate(maxKVDim)
        this.att = ArrayFloatTensor.allocate(
            config.numberOfHeads,
            config.contextLength
        )
        this.logits = ArrayFloatTensor.allocate(config.vocabularySize)
        
        let plDim = config.embeddingLengthPerLayer
        this.perLayerInputs = plDim > 0
            ? ArrayFloatTensor.allocate(plDim * config.numberOfLayers)
            : null
        this.plGate = plDim > 0 ? ArrayFloatTensor.allocate(plDim) : null
        this.plProj = plDim > 0 ? ArrayFloatTensor.allocate(config.embeddingLength) : null

        if config.isMoE() {
            this.routerLogits = ArrayFloatTensor.allocate(config.expertCount)
            this.moeInput = ArrayFloatTensor.allocate(config.embeddingLength)
            this.moeOutput = ArrayFloatTensor.allocate(config.embeddingLength)
            this.expertGateUp = ArrayFloatTensor.allocate(2 * config.expertFeedForwardLength)
            this.expertDown = ArrayFloatTensor.allocate(config.embeddingLength)
        } else {
            this.routerLogits = null
            this.moeInput = null
            this.moeOutput = null
            this.expertGateUp = null
            this.expertDown = null
        }

        this.keyCache = new FloatTensor[config.nLayerKvFromStart]
        this.valueCache = new FloatTensor[config.nLayerKvFromStart]
        var l = 0
        while l < config.nLayerKvFromStart {
            let kvDim = config.kvDim(l)
            let kvPositions = config.kvCachePositions(l)
            keyCache[l] = F16FloatTensor.allocate(kvPositions, kvDim)
            valueCache[l] = F16FloatTensor.allocate(kvPositions, kvDim)
            l = l + 1
        }
    }
}

class Parallel {
    static func parallelFor(
        startInclusive: int,
        endExclusive: int,
        action: IntConsumer
    ) {
        IntStream.range(startInclusive, endExclusive)
            .parallel()
            .forEach(action)
    }
}

class Float16 {
    static let BYTES = 2
}

class RoPE {
    static func precomputeFreqsCis(
        contextLength: int,
        headSize: int,
        theta: double
    ): Pair<float[], float[]> {
        assert headSize % 2 == 0
        let halfHead = headSize / 2
        let cr = new float[contextLength * halfHead]
        let ci = new float[contextLength * halfHead]
        var n = 0
        var pos = 0
        while pos < contextLength {
            var i = 0
            while i < headSize {
                let freq = (float) (1.0 / Math.pow(theta, i / (double) headSize))
                let val = pos * freq
                cr[n] = (float) Math.cos(val)
                ci[n] = (float) Math.sin(val)
                n = n + 1
                i = i + 2
            }
            pos = pos + 1
        }
        assert contextLength * halfHead == n
        return Pair(cr, ci)
    }

    static func precomputeFreqsCisFromFreqs(
        contextLength: int,
        headSize: int,
        ropeTheta: double,
        ropeFreqFactors: float[]
    ): Pair<float[], float[]> {
        let halfHead = ropeFreqFactors.length
        assert halfHead == headSize / 2
        let cr = new float[contextLength * halfHead]
        let ci = new float[contextLength * halfHead]
        var n = 0
        var pos = 0
        while pos < contextLength {
            var i = 0
            while i < halfHead {
                let baseFreq = (float) (1.0 / Math.pow(ropeTheta, (2.0 * i) / headSize))
                let val = (pos * baseFreq) / ropeFreqFactors[i]
                cr[n] = (float) Math.cos(val)
                ci[n] = (float) Math.sin(val)
                n = n + 1
                i = i + 1
            }
            pos = pos + 1
        }
        assert contextLength * halfHead == n
        return Pair(cr, ci)
    }
}

// ==========================================
// Float Tensor Architecture
// ==========================================

abstract class FloatTensor {
    static let VECTOR_BIT_SIZE: int = FloatTensor.initVectorBitSize()
    static let USE_VECTOR_API: boolean = (FloatTensor.VECTOR_BIT_SIZE != 0)

    static let F_SPECIES: VectorSpecies<Float> = FloatTensor.initFSpecies()
    static let I_SPECIES: VectorSpecies<Integer> = FloatTensor.initISpecies()
    static let S_SPECIES_HALF: VectorSpecies<Short> = FloatTensor.initSSpecies()

    static let UNSAFE: sun.misc.Unsafe = FloatTensor.initUnsafe()

    static func initVectorBitSize(): int {
        return Integer.getInteger(
            "llama.VectorBitSize",
            VectorShape.preferredShape().vectorBitSize()
        )
    }

    static func initUnsafe(): sun.misc.Unsafe {
        try {
            let f = sun.misc.Unsafe.class.getDeclaredField("theUnsafe")
            f.setAccessible(true)
            return f.get(null) as sun.misc.Unsafe
        } catch (Exception e) {
            throw RuntimeException(e)
        }
    }

    static func initFSpecies(): VectorSpecies<Float> {
        return FloatTensor.USE_VECTOR_API ? VectorShape.forBitSize(FloatTensor.VECTOR_BIT_SIZE).withLanes(java.lang.Float.TYPE) as VectorSpecies<Float> : null
    }

    static func initISpecies(): VectorSpecies<Integer> {
        return FloatTensor.USE_VECTOR_API ? FloatTensor.F_SPECIES.withLanes(java.lang.Integer.TYPE) as VectorSpecies<Integer> : null
    }

    static func initSSpecies(): VectorSpecies<Short> {
        return FloatTensor.USE_VECTOR_API ? VectorShape.forBitSize(FloatTensor.F_SPECIES.vectorBitSize() / 2).withLanes(java.lang.Short.TYPE) as VectorSpecies<Short> : null
    }

    static func readShort(memorySegment: MemorySegment, offset: long): short {
        return FloatTensor.UNSAFE.getShort(memorySegment.address() + offset)
    }

    static func writeShort(
        memorySegment: MemorySegment,
        offset: long,
        value: short
    ) {
        FloatTensor.UNSAFE.putShort(memorySegment.address() + offset, value)
    }

    static func readFloat16(memorySegment: MemorySegment, offset: long): float {
        return Float.float16ToFloat(FloatTensor.readShort(memorySegment, offset))
    }

    static func readByte(memorySegment: MemorySegment, offset: long): byte {
        return FloatTensor.UNSAFE.getByte(memorySegment.address() + offset)
    }

    static func readFloat(memorySegment: MemorySegment, offset: long): float {
        return FloatTensor.UNSAFE.getFloat(memorySegment.address() + offset)
    }

    abstract func size(): long
    abstract func getFloat(index: long): float
    abstract func setFloat(index: int, value: float)
    abstract func getFloatVector(species: VectorSpecies<Float>, offset: int): FloatVector
    abstract func type(): GGMLType

    static func numberOfElements(dims: int[]): int {
        return Arrays.stream(dims)
            .reduce((a, b) -> Math.multiplyExact(a, b))
            .orElseThrow()
    }

    static func numberOfElementsLong(dims: int[]): long {
        var result = 1L
        for d in dims {
            assert d > 0
            result = Math.multiplyExact(result, (long) d)
        }
        return result
    }

    static func scalarDot(
        thiz: FloatTensor,
        thisOffset: int,
        that: FloatTensor,
        thatOffset: int,
        size: int
    ): float {
        var result = 0.0f
        var j = 0
        while j < size {
            result = result + thiz.getFloat((long) (thisOffset + j)) * that.getFloat((long) (thatOffset + j))
            j = j + 1
        }
        return result
    }

    func dot(thisOffset: int, that: FloatTensor, thatOffset: int, size: int): float {
        return FloatTensor.scalarDot(this, thisOffset, that, thatOffset, size)
    }

    func matmul(that: FloatTensor, out: FloatTensor, dim0: int, dim1: int) {
        Parallel.parallelFor(0, dim0, i ->
            out.setFloat(i, dot(i * dim1, that, 0, dim1))
        )
    }

    func matmul(
        that: FloatTensor,
        out: FloatTensor,
        dim0: int,
        dim1: int,
        thisOffset: int
    ) {
        Parallel.parallelFor(0, dim0, i ->
            out.setFloat(i, dot(thisOffset + i * dim1, that, 0, dim1))
        )
    }

    func reduce(
        thisOffset: int,
        size: int,
        seed: float,
        reduceFn: java.util.function.BiFunction<Float, Float, Float>
    ): float {
        var result = seed
        var i = 0
        while i < size {
            result = (float) reduceFn.apply(result, getFloat((long) (thisOffset + i)))
            i = i + 1
        }
        return result
    }

    func sum(thisOffset: int, size: int): float {
        return reduce(thisOffset, size, 0.0f, (a, b) -> Float.sum(a, b))
    }

    func max(thisOffset: int, size: int): float {
        return reduce(thisOffset, size, Float.NEGATIVE_INFINITY, (a, b) -> Float.max(a, b))
    }

    func copyTo(thisOffset: int, that: FloatTensor, thatOffset: int, size: int) {
        that.mapWithIndexInPlace(thatOffset, size, (value, index) ->
            this.getFloat((long) (index - thatOffset + thisOffset))
        )
    }

    func argmax(thisOffset: int, size: int): int {
        assert size > 0
        var maxIndex = thisOffset
        var maxValue = this.getFloat((long) maxIndex)
        let endIndex = thisOffset + size
        var i = thisOffset
        while i < endIndex {
            let f = this.getFloat((long) i)
            if f > maxValue {
                maxValue = f
                maxIndex = i
            }
            i = i + 1
        }
        return maxIndex
    }

    func argmax(): int {
        return argmax(0, Math.toIntExact(size()))
    }

    func mapInPlace(thisOffset: int, size: int, mapFn: java.util.function.Function<Float, Float>) {
        let endIndex = thisOffset + size
        var i = thisOffset
        while i < endIndex {
            setFloat(i, (float) mapFn.apply(getFloat((long) i)))
            i = i + 1
        }
    }

    func mapInPlace(mapFn: java.util.function.Function<Float, Float>) {
        mapInPlace(0, Math.toIntExact(size()), mapFn)
    }

    func mapWithIndexInPlace(
        thisOffset: int,
        size: int,
        mapWithIndexFn: java.util.function.BiFunction<Float, Integer, Float>
    ) {
        let endOffset = thisOffset + size
        var i = thisOffset
        while i < endOffset {
            setFloat(i, (float) mapWithIndexFn.apply(getFloat((long) i), i))
            i = i + 1
        }
    }

    func addInPlace(
        thisOffset: int,
        that: FloatTensor,
        thatOffset: int,
        size: int
    ) {
        mapWithIndexInPlace(
            thisOffset,
            size,
            (value, index) ->
                value + that.getFloat((long) (index - thisOffset + thatOffset))
        )
    }

    func addInPlace(that: FloatTensor) {
        addInPlace(0, that, 0, Math.toIntExact(size()))
    }

    func multiplyInPlace(
        thisOffset: int,
        that: FloatTensor,
        thatOffset: int,
        size: int
    ) {
        mapWithIndexInPlace(
            thisOffset,
            size,
            (value, index) ->
                value * that.getFloat((long) (index - thisOffset + thatOffset))
        )
    }

    func divideInPlace(thisOffset: int, size: int, value: float) {
        mapInPlace(thisOffset, size, f -> f / value)
    }

    func fillInPlace(thisOffset: int, size: int, value: float) {
        mapInPlace(thisOffset, size, unused -> value)
    }

    func softmaxInPlace(thisOffset: int, size: int) {
        let maxVal = max(thisOffset, size)
        mapInPlace(thisOffset, size, f -> (float) Math.exp(f - maxVal))
        let sumVal = sum(thisOffset, size)
        divideInPlace(thisOffset, size, sumVal)
    }

    func saxpyInPlace(
        thisOffset: int,
        that: FloatTensor,
        thatOffset: int,
        size: int,
        a: float
    ) {
        var i = 0
        while i < size {
            setFloat(
                thisOffset + i,
                a * that.getFloat((long) (thatOffset + i)) +
                this.getFloat((long) (thisOffset + i))
            )
            i = i + 1
        }
    }
}

class Q4_0FloatTensor: FloatTensor {
    let size: long
    let memorySegment: MemorySegment

    init(size: long, memorySegment: MemorySegment) {
        this.size = size
        this.memorySegment = memorySegment
    }

    override func size(): long {
        return size
    }

    override func setFloat(index: int, value: float) {
        throw UnsupportedOperationException("setFloat")
    }

    override func getFloatVector(species: VectorSpecies<Float>, offset: int): FloatVector {
        throw UnsupportedOperationException("getFloatVector")
    }

    override func type(): GGMLType {
        return GGMLType.Q4_0
    }

    override func getFloat(index: long): float {
        assert 0 <= index && index < size
        let blockIndex = index / GGMLType.Q4_0.getBlockSize()
        let blockOffset = blockIndex * GGMLType.Q4_0.getTypeSize()
        let scale = FloatTensor.readFloat16(memorySegment, blockOffset)
        var quant = (byte) 0
        let modIndex = (int) (index % GGMLType.Q4_0.getBlockSize())
        if modIndex < GGMLType.Q4_0.getBlockSize() / 2 {
            quant = (byte) (FloatTensor.readByte(
                memorySegment,
                blockOffset + Float16.BYTES + modIndex
            ) & (byte) 0x0F)
        } else {
            quant = (byte) ((FloatTensor.readByte(
                memorySegment,
                blockOffset +
                Float16.BYTES +
                modIndex -
                GGMLType.Q4_0.getBlockSize() / 2
            ) >>> 4) & (byte) 0x0F)
        }
        quant = (byte) (quant - 8)
        return (float) quant * scale
    }

    override func dot(thisOffset: int, that: FloatTensor, thatOffset: int, size: int): float {
        if FloatTensor.USE_VECTOR_API {
            return Q4_0FloatTensor.vectorDot(this, thisOffset, that as ArrayFloatTensor, thatOffset, size)
        } else {
            return FloatTensor.scalarDot(this, thisOffset, that, thatOffset, size)
        }
    }

    static func vectorDot(
        thiz: Q4_0FloatTensor,
        thisOffset: int,
        that: ArrayFloatTensor,
        thatOffset: int,
        size: int
    ): float {
        var result = 0.0f
        var j = 0

        assert Integer.bitCount(GGMLType.Q4_0.getBlockSize()) == 1 : "power of 2"
        let alignmentBound = Math.min(
            size,
            -thisOffset & (GGMLType.Q4_0.getBlockSize() - 1)
        )
        if alignmentBound > 0 {
            result = result + FloatTensor.scalarDot(thiz, thisOffset, that, thatOffset, alignmentBound)
            j = j + alignmentBound
        }
        assert (thisOffset + j) % GGMLType.Q4_0.getBlockSize() == 0

        var val = FloatVector.zero(FloatTensor.F_SPECIES)
        var blockOffset = ((long) (thisOffset + j) / GGMLType.Q4_0.getBlockSize()) * GGMLType.Q4_0.getTypeSize()
        let upperBound = j + ((size - j) / GGMLType.Q4_0.getBlockSize()) * GGMLType.Q4_0.getBlockSize()

        while j < upperBound {
            let wScaleValue = FloatTensor.readFloat16(thiz.memorySegment, blockOffset)
            let wScale = FloatVector.broadcast(FloatTensor.F_SPECIES, wScaleValue)
            let wBytes = ByteVector.fromMemorySegment(
                ByteVector.SPECIES_128,
                thiz.memorySegment,
                blockOffset + Float16.BYTES,
                ByteOrder.LITTLE_ENDIAN
            )
            let loBytes = wBytes.and((byte) 0xF).sub((byte) 8)
            let hiBytes = wBytes.lanewise(VectorOperators.LSHR, 4).sub((byte) 8)
            
            let fSize = FloatTensor.F_SPECIES.vectorBitSize()
            if fSize == 512 {
                let s0 = that.getFloatVector(FloatTensor.F_SPECIES, thatOffset + j)
                    .mul(loBytes.castShape(FloatTensor.F_SPECIES, 0))
                let s1 = that.getFloatVector(FloatTensor.F_SPECIES, thatOffset + j + FloatTensor.F_SPECIES.length())
                    .mul(hiBytes.castShape(FloatTensor.F_SPECIES, 0))
                val = s0.add(s1).fma(wScale, val)
            } else if fSize == 256 {
                var s0 = that.getFloatVector(FloatTensor.F_SPECIES, thatOffset + j)
                    .mul(loBytes.castShape(FloatTensor.F_SPECIES, 0))
                var s1 = that.getFloatVector(FloatTensor.F_SPECIES, thatOffset + j + 2 * FloatTensor.F_SPECIES.length())
                    .mul(hiBytes.castShape(FloatTensor.F_SPECIES, 0))
                s0 = that.getFloatVector(FloatTensor.F_SPECIES, thatOffset + j + FloatTensor.F_SPECIES.length())
                    .fma(loBytes.castShape(FloatTensor.F_SPECIES, 1), s0)
                s1 = that.getFloatVector(FloatTensor.F_SPECIES, thatOffset + j + 3 * FloatTensor.F_SPECIES.length())
                    .fma(hiBytes.castShape(FloatTensor.F_SPECIES, 1), s1)
                val = s0.add(s1).fma(wScale, val)
            } else if fSize == 128 {
                var i = 0
                while i < 2 {
                    let tmp = (i == 0) ? loBytes : hiBytes
                    var s0 = that.getFloatVector(FloatTensor.F_SPECIES, thatOffset + j + (i * 4) * FloatTensor.F_SPECIES.length())
                        .mul(tmp.castShape(FloatTensor.F_SPECIES, 0))
                    var s1 = that.getFloatVector(FloatTensor.F_SPECIES, thatOffset + j + (i * 4 + 2) * FloatTensor.F_SPECIES.length())
                        .mul(tmp.castShape(FloatTensor.F_SPECIES, 2))
                    s0 = that.getFloatVector(FloatTensor.F_SPECIES, thatOffset + j + (i * 4 + 1) * FloatTensor.F_SPECIES.length())
                        .fma(tmp.castShape(FloatTensor.F_SPECIES, 1), s0)
                    s1 = that.getFloatVector(FloatTensor.F_SPECIES, thatOffset + j + (i * 4 + 3) * FloatTensor.F_SPECIES.length())
                        .fma(tmp.castShape(FloatTensor.F_SPECIES, 3), s1)
                    val = s0.add(s1).fma(wScale, val)
                    i = i + 1
                }
            } else {
                throw UnsupportedOperationException(FloatTensor.F_SPECIES.toString())
            }

            j = j + GGMLType.Q4_0.getBlockSize()
            blockOffset = blockOffset + GGMLType.Q4_0.getTypeSize()
        }
        
        result = result + val.reduceLanes(VectorOperators.ADD)

        if j < size {
            result = result + FloatTensor.scalarDot(thiz, thisOffset + j, that, thatOffset + j, size - j)
        }

        return result
    }
}

class Q4_1FloatTensor: FloatTensor {
    let size: long
    let memorySegment: MemorySegment

    init(size: long, memorySegment: MemorySegment) {
        this.size = size
        this.memorySegment = memorySegment
    }

    override func size(): long {
        return size
    }

    override func setFloat(index: int, value: float) {
        throw UnsupportedOperationException("setFloat")
    }

    override func getFloatVector(species: VectorSpecies<Float>, offset: int): FloatVector {
        throw UnsupportedOperationException("getFloatVector")
    }

    override func type(): GGMLType {
        return GGMLType.Q4_1
    }

    override func getFloat(index: long): float {
        assert 0 <= index && index < size
        let blockIndex = index / GGMLType.Q4_1.getBlockSize()
        let blockOffset = blockIndex * GGMLType.Q4_1.getTypeSize()
        let delta = FloatTensor.readFloat16(memorySegment, blockOffset)
        let minVal = FloatTensor.readFloat16(memorySegment, blockOffset + Float16.BYTES)
        let modIndex = (int) (index % GGMLType.Q4_1.getBlockSize())
        var quant = 0
        if modIndex < 16 {
            quant = Byte.toUnsignedInt(FloatTensor.readByte(
                memorySegment,
                blockOffset + 2 * Float16.BYTES + modIndex
            )) & 0x0F
        } else {
            quant = (Byte.toUnsignedInt(FloatTensor.readByte(
                memorySegment,
                blockOffset + 2 * Float16.BYTES + modIndex - 16
            )) >>> 4) & 0x0F
        }
        return delta * (float) quant + minVal
    }

    override func dot(thisOffset: int, that: FloatTensor, thatOffset: int, size: int): float {
        if FloatTensor.USE_VECTOR_API {
            return Q4_1FloatTensor.vectorDot(this, thisOffset, that as ArrayFloatTensor, thatOffset, size)
        } else {
            return FloatTensor.scalarDot(this, thisOffset, that, thatOffset, size)
        }
    }

    static func vectorDot(
        thiz: Q4_1FloatTensor,
        thisOffset: int,
        that: ArrayFloatTensor,
        thatOffset: int,
        size: int
    ): float {
        var result = 0.0f
        var j = 0

        assert Integer.bitCount(GGMLType.Q4_1.getBlockSize()) == 1 : "power of 2"
        let alignmentBound = Math.min(
            size,
            -thisOffset & (GGMLType.Q4_1.getBlockSize() - 1)
        )
        if alignmentBound > 0 {
            result = result + FloatTensor.scalarDot(thiz, thisOffset, that, thatOffset, alignmentBound)
            j = j + alignmentBound
        }
        assert (thisOffset + j) % GGMLType.Q4_1.getBlockSize() == 0

        var val = FloatVector.zero(FloatTensor.F_SPECIES)
        var blockOffset = ((long) (thisOffset + j) / GGMLType.Q4_1.getBlockSize()) * GGMLType.Q4_1.getTypeSize()
        let upperBound = j + ((size - j) / GGMLType.Q4_1.getBlockSize()) * GGMLType.Q4_1.getBlockSize()

        while j < upperBound {
            let deltaValue = FloatTensor.readFloat16(thiz.memorySegment, blockOffset)
            let minValue = FloatTensor.readFloat16(thiz.memorySegment, blockOffset + Float16.BYTES)
            let wDelta = FloatVector.broadcast(FloatTensor.F_SPECIES, deltaValue)
            let wMin = FloatVector.broadcast(FloatTensor.F_SPECIES, minValue)
            let wBytes = ByteVector.fromMemorySegment(
                ByteVector.SPECIES_128,
                thiz.memorySegment,
                blockOffset + 2 * Float16.BYTES,
                ByteOrder.LITTLE_ENDIAN
            )
            let loBytes = wBytes.and((byte) 0xF)
            let hiBytes = wBytes.lanewise(VectorOperators.LSHR, 4)
            
            let fSize = FloatTensor.F_SPECIES.vectorBitSize()
            if fSize == 512 {
                let that0 = that.getFloatVector(FloatTensor.F_SPECIES, thatOffset + j)
                let that1 = that.getFloatVector(FloatTensor.F_SPECIES, thatOffset + j + FloatTensor.F_SPECIES.length())
                let s0 = that0.mul(loBytes.castShape(FloatTensor.F_SPECIES, 0))
                let s1 = that1.mul(hiBytes.castShape(FloatTensor.F_SPECIES, 0))
                val = s0.add(s1).fma(wDelta, val)
                val = that0.add(that1).fma(wMin, val)
            } else if fSize == 256 {
                let that0 = that.getFloatVector(FloatTensor.F_SPECIES, thatOffset + j)
                let that1 = that.getFloatVector(FloatTensor.F_SPECIES, thatOffset + j + FloatTensor.F_SPECIES.length())
                let that2 = that.getFloatVector(FloatTensor.F_SPECIES, thatOffset + j + 2 * FloatTensor.F_SPECIES.length())
                let that3 = that.getFloatVector(FloatTensor.F_SPECIES, thatOffset + j + 3 * FloatTensor.F_SPECIES.length())
                var s0 = that0.mul(loBytes.castShape(FloatTensor.F_SPECIES, 0))
                var s1 = that2.mul(hiBytes.castShape(FloatTensor.F_SPECIES, 0))
                s0 = that1.fma(loBytes.castShape(FloatTensor.F_SPECIES, 1), s0)
                s1 = that3.fma(hiBytes.castShape(FloatTensor.F_SPECIES, 1), s1)
                val = s0.add(s1).fma(wDelta, val)
                val = that0.add(that1).add(that2).add(that3).fma(wMin, val)
            } else if fSize == 128 {
                var i = 0
                while i < 2 {
                    let tmp = (i == 0) ? loBytes : hiBytes
                    var s0 = that.getFloatVector(FloatTensor.F_SPECIES, thatOffset + j + (i * 4) * FloatTensor.F_SPECIES.length())
                        .mul(tmp.castShape(FloatTensor.F_SPECIES, 0))
                    var s1 = that.getFloatVector(FloatTensor.F_SPECIES, thatOffset + j + (i * 4 + 2) * FloatTensor.F_SPECIES.length())
                        .mul(tmp.castShape(FloatTensor.F_SPECIES, 2))
                    s0 = that.getFloatVector(FloatTensor.F_SPECIES, thatOffset + j + (i * 4 + 1) * FloatTensor.F_SPECIES.length())
                        .fma(tmp.castShape(FloatTensor.F_SPECIES, 1), s0)
                    s1 = that.getFloatVector(FloatTensor.F_SPECIES, thatOffset + j + (i * 4 + 3) * FloatTensor.F_SPECIES.length())
                        .fma(tmp.castShape(FloatTensor.F_SPECIES, 3), s1)
                    val = s0.add(s1).fma(wDelta, val)
                    i = i + 1
                }
                var thatSum = FloatVector.zero(FloatTensor.F_SPECIES)
                var k = 0
                while k < GGMLType.Q4_1.getBlockSize() {
                    thatSum = thatSum.add(that.getFloatVector(FloatTensor.F_SPECIES, thatOffset + j + k))
                    k = k + FloatTensor.F_SPECIES.length()
                }
                val = thatSum.fma(wMin, val)
            } else {
                throw UnsupportedOperationException(FloatTensor.F_SPECIES.toString())
            }

            j = j + GGMLType.Q4_1.getBlockSize()
            blockOffset = blockOffset + GGMLType.Q4_1.getTypeSize()
        }

        result = result + val.reduceLanes(VectorOperators.ADD)

        if j < size {
            result = result + FloatTensor.scalarDot(thiz, thisOffset + j, that, thatOffset + j, size - j)
        }

        return result
    }
}

class Q5_1FloatTensor: FloatTensor {
    let size: long
    let memorySegment: MemorySegment

    init(size: long, memorySegment: MemorySegment) {
        this.size = size
        this.memorySegment = memorySegment
    }

    override func size(): long {
        return size
    }

    override func setFloat(index: int, value: float) {
        throw UnsupportedOperationException("setFloat")
    }

    override func getFloatVector(species: VectorSpecies<Float>, offset: int): FloatVector {
        throw UnsupportedOperationException("getFloatVector")
    }

    override func type(): GGMLType {
        return GGMLType.Q5_1
    }

    override func getFloat(index: long): float {
        assert 0 <= index && index < size
        let blockIndex = index / GGMLType.Q5_1.getBlockSize()
        let inBlockIndex = (int) (index % GGMLType.Q5_1.getBlockSize())
        let blockOffset = blockIndex * GGMLType.Q5_1.getTypeSize()

        let d = FloatTensor.readFloat16(memorySegment, blockOffset)
        let m = FloatTensor.readFloat16(memorySegment, blockOffset + Float16.BYTES)
        let qh = Q5_1FloatTensor.readInt32LE(memorySegment, blockOffset + 2L * Float16.BYTES)

        var j = 0
        var nibble = 0
        var xh = 0
        if inBlockIndex < GGMLType.Q5_1.getBlockSize() / 2 {
            j = inBlockIndex
            nibble = Byte.toUnsignedInt(FloatTensor.readByte(
                memorySegment,
                blockOffset + 2L * Float16.BYTES + Integer.BYTES + j
            )) & 0x0F
            xh = ((qh >> j) << 4) & 0x10
        } else {
            j = inBlockIndex - GGMLType.Q5_1.getBlockSize() / 2
            nibble = (Byte.toUnsignedInt(FloatTensor.readByte(
                memorySegment,
                blockOffset + 2L * Float16.BYTES + Integer.BYTES + j
            )) >>> 4) & 0x0F
            xh = (qh >> (j + 12)) & 0x10
        }

        let q = nibble | xh
        return (float) q * d + m
    }

    override func dot(thisOffset: int, that: FloatTensor, thatOffset: int, size: int): float {
        if that is ArrayFloatTensor {
            let aft = that as ArrayFloatTensor
            if FloatTensor.USE_VECTOR_API {
                return Q5_1FloatTensor.vectorDot(this, thisOffset, aft, thatOffset, size)
            }
            return Q5_1FloatTensor.scalarDot(this, thisOffset, aft, thatOffset, size)
        }
        return FloatTensor.scalarDot(this, thisOffset, that, thatOffset, size)
    }

    static func vectorDot(
        thiz: Q5_1FloatTensor,
        thisOffset: int,
        that: ArrayFloatTensor,
        thatOffset: int,
        size: int
    ): float {
        assert Integer.bitCount(GGMLType.Q5_1.getBlockSize()) == 1 : "power of 2"
        var j = 0
        var result = 0.0f

        let alignmentBound = Math.min(
            size,
            -thisOffset & (GGMLType.Q5_1.getBlockSize() - 1)
        )
        if alignmentBound > 0 {
            result = result + Q5_1FloatTensor.scalarDot(thiz, thisOffset, that, thatOffset, alignmentBound)
            j = alignmentBound
        }

        let decoded = new float[GGMLType.Q5_1.getBlockSize()]
        let upperBound = j + ((size - j) / GGMLType.Q5_1.getBlockSize()) * GGMLType.Q5_1.getBlockSize()
        let vecUpper = FloatTensor.F_SPECIES.loopBound(GGMLType.Q5_1.getBlockSize())
        
        while j < upperBound {
            assert (thisOffset + j) % GGMLType.Q5_1.getBlockSize() == 0
            let blockOffset = ((long) (thisOffset + j) / GGMLType.Q5_1.getBlockSize()) * GGMLType.Q5_1.getTypeSize()
            let d = FloatTensor.readFloat16(thiz.memorySegment, blockOffset)
            let m = FloatTensor.readFloat16(thiz.memorySegment, blockOffset + Float16.BYTES)
            let qh = Q5_1FloatTensor.readInt32LE(thiz.memorySegment, blockOffset + 2L * Float16.BYTES)
            let qsBase = blockOffset + 2L * Float16.BYTES + Integer.BYTES

            var p = 0
            while p < GGMLType.Q5_1.getBlockSize() / 2 {
                let packed = Byte.toUnsignedInt(FloatTensor.readByte(thiz.memorySegment, qsBase + p))
                let x0 = (packed & 0x0F) | ((((qh >> p) << 4) & 0x10))
                let x1 = ((packed >>> 4) & 0x0F) | ((qh >> (p + 12)) & 0x10)
                decoded[p] = (float) x0 * d + m
                decoded[p + GGMLType.Q5_1.getBlockSize() / 2] = (float) x1 * d + m
                p = p + 1
            }

            var acc = FloatVector.zero(FloatTensor.F_SPECIES)
            var i = 0
            while i < vecUpper {
                let w = FloatVector.fromArray(FloatTensor.F_SPECIES, decoded, i)
                let x = that.getFloatVector(FloatTensor.F_SPECIES, thatOffset + j + i)
                acc = w.fma(x, acc)
                i = i + FloatTensor.F_SPECIES.length()
            }
            result = result + acc.reduceLanes(VectorOperators.ADD)

            i = vecUpper
            while i < GGMLType.Q5_1.getBlockSize() {
                result = result + decoded[i] * that.values[thatOffset + j + i]
                i = i + 1
            }

            j = j + GGMLType.Q5_1.getBlockSize()
        }

        if j < size {
            result = result + Q5_1FloatTensor.scalarDot(thiz, thisOffset + j, that, thatOffset + j, size - j)
        }
        return result
    }

    static func scalarDot(
        thiz: Q5_1FloatTensor,
        thisOffset: int,
        that: ArrayFloatTensor,
        thatOffset: int,
        size: int
    ): float {
        var result = 0.0f
        var i = 0
        while i < size {
            result = result + thiz.getFloat((long) (thisOffset + i)) * that.values[thatOffset + i]
            i = i + 1
        }
        return result
    }

    static func readInt32LE(memorySegment: MemorySegment, offset: long): int {
        let b0 = Byte.toUnsignedInt(FloatTensor.readByte(memorySegment, offset))
        let b1 = Byte.toUnsignedInt(FloatTensor.readByte(memorySegment, offset + 1L))
        let b2 = Byte.toUnsignedInt(FloatTensor.readByte(memorySegment, offset + 2L))
        let b3 = Byte.toUnsignedInt(FloatTensor.readByte(memorySegment, offset + 3L))
        return b0 | (b1 << 8) | (b2 << 16) | (b3 << 24)
    }
}

class Q4_KFloatTensor: FloatTensor {
    static let BLOCK_SIZE = GGMLType.QK_K
    static let TYPE_SIZE: int = 2 * Float16.BYTES + (((GGMLType.QK_K / 16) / 8) * 6) + GGMLType.QK_K / 2

    let size: long
    let memorySegment: MemorySegment

    init(size: long, memorySegment: MemorySegment) {
        this.size = size
        this.memorySegment = memorySegment
    }

    override func size(): long {
        return size
    }

    override func setFloat(index: int, value: float) {
        throw UnsupportedOperationException("setFloat")
    }

    override func getFloatVector(species: VectorSpecies<Float>, offset: int): FloatVector {
        throw UnsupportedOperationException("getFloatVector")
    }

    override func type(): GGMLType {
        return GGMLType.Q4_K
    }

    static func getScaleMinK4(
        j: int,
        mem: MemorySegment,
        scalesOffset: long,
        isMin: boolean
    ): int {
        if j < 4 {
            let idx = isMin ? j + 4 : j
            return Byte.toUnsignedInt(FloatTensor.readByte(mem, scalesOffset + (long) idx)) & 63
        } else {
            let lowIdx = j + 4
            let highIdx = isMin ? j : j - 4
            let low = isMin
                ? (Byte.toUnsignedInt(FloatTensor.readByte(mem, scalesOffset + (long) lowIdx)) >> 4)
                : (Byte.toUnsignedInt(FloatTensor.readByte(mem, scalesOffset + (long) lowIdx)) & 0xF)
            let high = (Byte.toUnsignedInt(FloatTensor.readByte(mem, scalesOffset + (long) highIdx)) >> 6) & 0x3
            return low | (high << 4)
        }
    }

    override func getFloat(index: long): float {
        let blockIndex = index / BLOCK_SIZE
        let withinBlock = (int) (index % BLOCK_SIZE)
        let blockOffset = blockIndex * TYPE_SIZE
        let d = FloatTensor.readFloat16(memorySegment, blockOffset)
        let dmin = FloatTensor.readFloat16(memorySegment, blockOffset + 2L)
        let scalesOffset = blockOffset + 4L
        let qsOffset = blockOffset + 16L

        let group = withinBlock / 64
        let inGroup = withinBlock % 64
        var subBlock = 0
        var nibbleIndex = 0
        var isHigh = false
        if inGroup < 32 {
            subBlock = group * 2
            nibbleIndex = inGroup
            isHigh = false
        } else {
            subBlock = group * 2 + 1
            nibbleIndex = inGroup - 32
            isHigh = true
        }

        let sc = Q4_KFloatTensor.getScaleMinK4(subBlock, memorySegment, scalesOffset, false)
        let m = Q4_KFloatTensor.getScaleMinK4(subBlock, memorySegment, scalesOffset, true)

        let qsByte = FloatTensor.readByte(
            memorySegment,
            qsOffset + (long) (group * 32 + nibbleIndex)
        )
        let quant = isHigh
            ? ((Byte.toUnsignedInt(qsByte) >> 4) & 0xF)
            : (Byte.toUnsignedInt(qsByte) & 0xF)

        return d * (float) sc * (float) quant - dmin * (float) m
    }

    override func dot(thisOffset: int, that: FloatTensor, thatOffset: int, size: int): float {
        if FloatTensor.USE_VECTOR_API {
            return Q4_KFloatTensor.vectorDot(this, thisOffset, that as ArrayFloatTensor, thatOffset, size)
        } else {
            return FloatTensor.scalarDot(this, thisOffset, that, thatOffset, size)
        }
    }

    static func vectorDot(
        thiz: Q4_KFloatTensor,
        thisOffset: int,
        that: ArrayFloatTensor,
        thatOffset: int,
        size: int
    ): float {
        var result = 0.0f
        var j = 0

        assert Integer.bitCount(BLOCK_SIZE) == 1 : "power of 2"
        let alignmentBound = Math.min(size, -thisOffset & (BLOCK_SIZE - 1))
        if alignmentBound > 0 {
            result = result + FloatTensor.scalarDot(thiz, thisOffset, that, thatOffset, alignmentBound)
            j = j + alignmentBound
        }

        var val = FloatVector.zero(FloatTensor.F_SPECIES)
        var val2 = FloatVector.zero(FloatTensor.F_SPECIES)
        var blockOffset = ((long) (thisOffset + j) / BLOCK_SIZE) * TYPE_SIZE
        let upperBound = j + ((size - j) / BLOCK_SIZE) * BLOCK_SIZE

        while j < upperBound {
            let d = FloatTensor.readFloat16(thiz.memorySegment, blockOffset)
            let dmin = FloatTensor.readFloat16(thiz.memorySegment, blockOffset + 2L)
            let scalesOff = blockOffset + 4L
            let qsOff = blockOffset + 16L

            var g = 0
            while g < 4 {
                let d1 = d * (float) Q4_KFloatTensor.getScaleMinK4(g * 2, thiz.memorySegment, scalesOff, false)
                let negM1 = -(dmin * (float) Q4_KFloatTensor.getScaleMinK4(g * 2, thiz.memorySegment, scalesOff, true))
                let d2 = d * (float) Q4_KFloatTensor.getScaleMinK4(g * 2 + 1, thiz.memorySegment, scalesOff, false)
                let negM2 = -(dmin * (float) Q4_KFloatTensor.getScaleMinK4(g * 2 + 1, thiz.memorySegment, scalesOff, true))

                let d1Vec = FloatVector.broadcast(FloatTensor.F_SPECIES, d1)
                let negM1Vec = FloatVector.broadcast(FloatTensor.F_SPECIES, negM1)
                let d2Vec = FloatVector.broadcast(FloatTensor.F_SPECIES, d2)
                let negM2Vec = FloatVector.broadcast(FloatTensor.F_SPECIES, negM2)

                let loBase = thatOffset + j + g * 64
                let hiBase = thatOffset + j + g * 64 + 32

                var c = 0
                while c < 2 {
                    let wBytes = ByteVector.fromMemorySegment(
                        ByteVector.SPECIES_128,
                        thiz.memorySegment,
                        qsOff + (long) (g * 32 + c * 16),
                        ByteOrder.LITTLE_ENDIAN
                    )
                    let loBytes = wBytes.and((byte) 0xF)
                    let hiBytes = wBytes.lanewise(VectorOperators.LSHR, 4)

                    let loIdx = loBase + c * 16
                    let hiIdx = hiBase + c * 16
                    
                    let fSize = FloatTensor.F_SPECIES.vectorBitSize()
                    if fSize == 512 {
                        let loQ = loBytes.castShape(FloatTensor.F_SPECIES, 0).reinterpretAsFloats()
                        val = loQ.fma(d1Vec, negM1Vec).fma(that.getFloatVector(FloatTensor.F_SPECIES, loIdx), val)
                        
                        let hiQ = hiBytes.castShape(FloatTensor.F_SPECIES, 0).reinterpretAsFloats()
                        val2 = hiQ.fma(d2Vec, negM2Vec).fma(that.getFloatVector(FloatTensor.F_SPECIES, hiIdx), val2)
                    } else if fSize == 256 {
                        let loQ0 = loBytes.castShape(FloatTensor.F_SPECIES, 0).reinterpretAsFloats()
                        let loQ1 = loBytes.castShape(FloatTensor.F_SPECIES, 1).reinterpretAsFloats()
                        val = loQ0.fma(d1Vec, negM1Vec).fma(that.getFloatVector(FloatTensor.F_SPECIES, loIdx), val)
                        val2 = loQ1.fma(d1Vec, negM1Vec).fma(that.getFloatVector(FloatTensor.F_SPECIES, loIdx + FloatTensor.F_SPECIES.length()), val2)
                        
                        let hiQ0 = hiBytes.castShape(FloatTensor.F_SPECIES, 0).reinterpretAsFloats()
                        let hiQ1 = hiBytes.castShape(FloatTensor.F_SPECIES, 1).reinterpretAsFloats()
                        val = hiQ0.fma(d2Vec, negM2Vec).fma(that.getFloatVector(FloatTensor.F_SPECIES, hiIdx), val)
                        val2 = hiQ1.fma(d2Vec, negM2Vec).fma(that.getFloatVector(FloatTensor.F_SPECIES, hiIdx + FloatTensor.F_SPECIES.length()), val2)
                    } else if fSize == 128 {
                        var p = 0
                        while p < 4 {
                            let loQ = loBytes.castShape(FloatTensor.F_SPECIES, p).reinterpretAsFloats()
                            val = loQ.fma(d1Vec, negM1Vec).fma(that.getFloatVector(FloatTensor.F_SPECIES, loIdx + p * FloatTensor.F_SPECIES.length()), val)
                            
                            let hiQ = hiBytes.castShape(FloatTensor.F_SPECIES, p).reinterpretAsFloats()
                            val2 = hiQ.fma(d2Vec, negM2Vec).fma(that.getFloatVector(FloatTensor.F_SPECIES, hiIdx + p * FloatTensor.F_SPECIES.length()), val2)
                            p = p + 1
                        }
                    } else {
                        throw UnsupportedOperationException(FloatTensor.F_SPECIES.toString())
                    }
                    c = c + 1
                }
                g = g + 1
            }
            j = j + BLOCK_SIZE
            blockOffset = blockOffset + TYPE_SIZE
        }

        result = result + val.add(val2).reduceLanes(VectorOperators.ADD)

        if j < size {
            result = result + FloatTensor.scalarDot(thiz, thisOffset + j, that, thatOffset + j, size - j)
        }

        return result
    }
}

class Q5_KFloatTensor: FloatTensor {
    static let BLOCK_SIZE = GGMLType.QK_K
    static let TYPE_SIZE: int = 2 * Float16.BYTES + (((GGMLType.QK_K / 16) / 8) * 6) + GGMLType.QK_K / 8 + GGMLType.QK_K / 2

    let size: long
    let memorySegment: MemorySegment

    init(size: long, memorySegment: MemorySegment) {
        this.size = size
        this.memorySegment = memorySegment
    }

    override func size(): long {
        return size
    }

    override func setFloat(index: int, value: float) {
        throw UnsupportedOperationException("setFloat")
    }

    override func getFloatVector(species: VectorSpecies<Float>, offset: int): FloatVector {
        throw UnsupportedOperationException("getFloatVector")
    }

    override func type(): GGMLType {
        return GGMLType.Q5_K
    }

    override func getFloat(index: long): float {
        let blockIndex = index / BLOCK_SIZE
        let withinBlock = (int) (index % BLOCK_SIZE)
        let blockOffset = blockIndex * TYPE_SIZE
        let d = FloatTensor.readFloat16(memorySegment, blockOffset)
        let dmin = FloatTensor.readFloat16(memorySegment, blockOffset + 2L)
        let scalesOffset = blockOffset + 4L
        let qhOffset = blockOffset + 16L
        let qsOffset = blockOffset + 48L

        let group = withinBlock / 64
        let inGroup = withinBlock % 64
        let isHigh = inGroup >= 32
        let l = isHigh ? inGroup - 32 : inGroup
        let subBlock = isHigh ? group * 2 + 1 : group * 2

        let sc = Q4_KFloatTensor.getScaleMinK4(subBlock, memorySegment, scalesOffset, false)
        let m = Q4_KFloatTensor.getScaleMinK4(subBlock, memorySegment, scalesOffset, true)

        let qsByte = FloatTensor.readByte(memorySegment, qsOffset + (long) (group * 32 + l))
        let nibble = isHigh
            ? ((Byte.toUnsignedInt(qsByte) >> 4) & 0xF)
            : (Byte.toUnsignedInt(qsByte) & 0xF)

        let qhBitPos = isHigh ? 2 * group + 1 : 2 * group
        let qhBit = (Byte.toUnsignedInt(FloatTensor.readByte(memorySegment, qhOffset + (long) l)) >> qhBitPos) & 1

        let quant = nibble | (qhBit << 4)
        return d * (float) sc * (float) quant - dmin * (float) m
    }

    override func dot(thisOffset: int, that: FloatTensor, thatOffset: int, size: int): float {
        if FloatTensor.USE_VECTOR_API {
            return Q5_KFloatTensor.vectorDot(this, thisOffset, that as ArrayFloatTensor, thatOffset, size)
        } else {
            return FloatTensor.scalarDot(this, thisOffset, that, thatOffset, size)
        }
    }

    static func vectorDot(
        thiz: Q5_KFloatTensor,
        thisOffset: int,
        that: ArrayFloatTensor,
        thatOffset: int,
        size: int
    ): float {
        var result = 0.0f
        var j = 0

        assert Integer.bitCount(BLOCK_SIZE) == 1 : "power of 2"
        let alignmentBound = Math.min(size, -thisOffset & (BLOCK_SIZE - 1))
        if alignmentBound > 0 {
            result = result + FloatTensor.scalarDot(thiz, thisOffset, that, thatOffset, alignmentBound)
            j = j + alignmentBound
        }

        var val = FloatVector.zero(FloatTensor.F_SPECIES)
        var val2 = FloatVector.zero(FloatTensor.F_SPECIES)
        var blockOffset = ((long) (thisOffset + j) / BLOCK_SIZE) * TYPE_SIZE
        let upperBound = j + ((size - j) / BLOCK_SIZE) * BLOCK_SIZE

        while j < upperBound {
            let d = FloatTensor.readFloat16(thiz.memorySegment, blockOffset)
            let dmin = FloatTensor.readFloat16(thiz.memorySegment, blockOffset + 2L)
            let scalesOff = blockOffset + 4L
            let qhOff = blockOffset + 16L
            let qsOff = blockOffset + 48L
            let qh0 = ByteVector.fromMemorySegment(
                ByteVector.SPECIES_128,
                thiz.memorySegment,
                qhOff,
                ByteOrder.LITTLE_ENDIAN
            )
            let qh1 = ByteVector.fromMemorySegment(
                ByteVector.SPECIES_128,
                thiz.memorySegment,
                qhOff + 16L,
                ByteOrder.LITTLE_ENDIAN
            )

            var g = 0
            while g < 4 {
                let loSubBlock = g * 2
                let hiSubBlock = loSubBlock + 1
                let d1 = d * (float) Q4_KFloatTensor.getScaleMinK4(loSubBlock, thiz.memorySegment, scalesOff, false)
                let m1 = dmin * (float) Q4_KFloatTensor.getScaleMinK4(loSubBlock, thiz.memorySegment, scalesOff, true)
                let d2 = d * (float) Q4_KFloatTensor.getScaleMinK4(hiSubBlock, thiz.memorySegment, scalesOff, false)
                let m2 = dmin * (float) Q4_KFloatTensor.getScaleMinK4(hiSubBlock, thiz.memorySegment, scalesOff, true)

                let qhBitPosLo = 2 * g
                let qhBitPosHi = qhBitPosLo + 1
                let groupQsOff = qsOff + (long) (g * 32)
                let d1Vec = FloatVector.broadcast(FloatTensor.F_SPECIES, d1)
                let d2Vec = FloatVector.broadcast(FloatTensor.F_SPECIES, d2)
                let negM1Vec = FloatVector.broadcast(FloatTensor.F_SPECIES, -m1)
                let negM2Vec = FloatVector.broadcast(FloatTensor.F_SPECIES, -m2)

                var c = 0
                while c < 2 {
                    let loBase = thatOffset + j + g * 64 + c * 16
                    let hiBase = thatOffset + j + g * 64 + 32 + c * 16

                    let wBytes = ByteVector.fromMemorySegment(
                        ByteVector.SPECIES_128,
                        thiz.memorySegment,
                        groupQsOff + (long) (c * 16),
                        ByteOrder.LITTLE_ENDIAN
                    )
                    var loQ = wBytes.and((byte) 0xF)
                    var hiQ = wBytes.lanewise(VectorOperators.LSHR, 4)

                    let qhBytes = (c == 0) ? qh0 : qh1
                    loQ = loQ.or(
                        qhBytes
                            .lanewise(VectorOperators.LSHR, qhBitPosLo)
                            .and((byte) 1)
                            .lanewise(VectorOperators.LSHL, 4)
                    )
                    hiQ = hiQ.or(
                        qhBytes
                            .lanewise(VectorOperators.LSHR, qhBitPosHi)
                            .and((byte) 1)
                            .lanewise(VectorOperators.LSHL, 4)
                    )

                    let fSize = FloatTensor.F_SPECIES.vectorBitSize()
                    if fSize == 512 {
                        let loQf = loQ.castShape(FloatTensor.F_SPECIES, 0).reinterpretAsFloats()
                        let hiQf = hiQ.castShape(FloatTensor.F_SPECIES, 0).reinterpretAsFloats()
                        val = loQf.fma(d1Vec, negM1Vec).fma(that.getFloatVector(FloatTensor.F_SPECIES, loBase), val)
                        val2 = hiQf.fma(d2Vec, negM2Vec).fma(that.getFloatVector(FloatTensor.F_SPECIES, hiBase), val2)
                    } else if fSize == 256 {
                        let loQf0 = loQ.castShape(FloatTensor.F_SPECIES, 0).reinterpretAsFloats()
                        let loQf1 = loQ.castShape(FloatTensor.F_SPECIES, 1).reinterpretAsFloats()
                        let hiQf0 = hiQ.castShape(FloatTensor.F_SPECIES, 0).reinterpretAsFloats()
                        let hiQf1 = hiQ.castShape(FloatTensor.F_SPECIES, 1).reinterpretAsFloats()
                        val = loQf0.fma(d1Vec, negM1Vec).fma(that.getFloatVector(FloatTensor.F_SPECIES, loBase), val)
                        val = loQf1.fma(d1Vec, negM1Vec).fma(that.getFloatVector(FloatTensor.F_SPECIES, loBase + FloatTensor.F_SPECIES.length()), val)
                        val2 = hiQf0.fma(d2Vec, negM2Vec).fma(that.getFloatVector(FloatTensor.F_SPECIES, hiBase), val2)
                        val2 = hiQf1.fma(d2Vec, negM2Vec).fma(that.getFloatVector(FloatTensor.F_SPECIES, hiBase + FloatTensor.F_SPECIES.length()), val2)
                    } else if fSize == 128 {
                        var p = 0
                        while p < 4 {
                            let off = p * FloatTensor.F_SPECIES.length()
                            let loQf = loQ.castShape(FloatTensor.F_SPECIES, p).reinterpretAsFloats()
                            let hiQf = hiQ.castShape(FloatTensor.F_SPECIES, p).reinterpretAsFloats()
                            val = loQf.fma(d1Vec, negM1Vec).fma(that.getFloatVector(FloatTensor.F_SPECIES, loBase + off), val)
                            val2 = hiQf.fma(d2Vec, negM2Vec).fma(that.getFloatVector(FloatTensor.F_SPECIES, hiBase + off), val2)
                            p = p + 1
                        }
                    } else {
                        throw UnsupportedOperationException(FloatTensor.F_SPECIES.toString())
                    }
                    c = c + 1
                }
                g = g + 1
            }
            j = j + BLOCK_SIZE
            blockOffset = blockOffset + TYPE_SIZE
        }

        result = result + val.add(val2).reduceLanes(VectorOperators.ADD)

        if j < size {
            result = result + FloatTensor.scalarDot(thiz, thisOffset + j, that, thatOffset + j, size - j)
        }

        return result
    }
}

class Q6_KFloatTensor: FloatTensor {
    static let BLOCK_SIZE = GGMLType.QK_K
    static let TYPE_SIZE: int = GGMLType.QK_K / 2 + GGMLType.QK_K / 4 + GGMLType.QK_K / 16 + Float16.BYTES

    let size: long
    let memorySegment: MemorySegment

    init(size: long, memorySegment: MemorySegment) {
        this.size = size
        this.memorySegment = memorySegment
    }

    override func size(): long {
        return size
    }

    override func setFloat(index: int, value: float) {
        throw UnsupportedOperationException("setFloat")
    }

    override func getFloatVector(species: VectorSpecies<Float>, offset: int): FloatVector {
        throw UnsupportedOperationException("getFloatVector")
    }

    override func type(): GGMLType {
        return GGMLType.Q6_K
    }

    override func getFloat(index: long): float {
        let blockIndex = index / BLOCK_SIZE
        let withinBlock = (int) (index % BLOCK_SIZE)
        let blockOffset = blockIndex * TYPE_SIZE
        let qlOff = blockOffset
        let qhOff = blockOffset + 128L
        let scOff = blockOffset + 192L
        let d = FloatTensor.readFloat16(memorySegment, blockOffset + 208L)

        let half = withinBlock / 128
        let rem128 = withinBlock % 128
        let sub32 = rem128 / 32
        let l = rem128 % 32

        let qlBase = qlOff + (long) (half * 64)
        let qhBase = qhOff + (long) (half * 32)

        var qlNibble = 0
        var qhShift = 0
        if sub32 == 0 {
            qlNibble = Byte.toUnsignedInt(FloatTensor.readByte(memorySegment, qlBase + (long) l)) & 0xF
            qhShift = 0
        } else if sub32 == 1 {
            qlNibble = Byte.toUnsignedInt(FloatTensor.readByte(memorySegment, qlBase + 32L + (long) l)) & 0xF
            qhShift = 2
        } else if sub32 == 2 {
            qlNibble = (Byte.toUnsignedInt(FloatTensor.readByte(memorySegment, qlBase + (long) l)) >> 4) & 0xF
            qhShift = 4
        } else if sub32 == 3 {
            qlNibble = (Byte.toUnsignedInt(FloatTensor.readByte(memorySegment, qlBase + 32L + (long) l)) >> 4) & 0xF
            qhShift = 6
        } else {
            throw IllegalStateException()
        }

        let qhBits = (Byte.toUnsignedInt(FloatTensor.readByte(memorySegment, qhBase + (long) l)) >> qhShift) & 3
        let q6 = (qlNibble | (qhBits << 4)) - 32
        let sc = (int) FloatTensor.readByte(memorySegment, scOff + (long) (half * 8 + sub32 * 2 + l / 16))

        return d * (float) sc * (float) q6
    }

    override func dot(thisOffset: int, that: FloatTensor, thatOffset: int, size: int): float {
        if FloatTensor.USE_VECTOR_API {
            return Q6_KFloatTensor.vectorDot(this, thisOffset, that as ArrayFloatTensor, thatOffset, size)
        } else {
            return FloatTensor.scalarDot(this, thisOffset, that, thatOffset, size)
        }
    }

    static func fp16ToFloatNoIntrinsic(h: short): float {
        let bits = Short.toUnsignedInt(h)
        let sign = (bits & 0x8000) << 16
        var exp = (bits >>> 10) & 0x1F
        var mantissa = bits & 0x03FF

        if exp == 0 {
            if mantissa == 0 {
                return Float.intBitsToFloat(sign)
            }
            var e = 127 - 15 + 1
            while (mantissa & 0x0400) == 0 {
                mantissa = mantissa << 1
                e = e - 1
            }
            mantissa = mantissa & 0x03FF
            return Float.intBitsToFloat(sign | (e << 23) | (mantissa << 13))
        }
        if exp == 0x1F {
            return Float.intBitsToFloat(sign | 0x7F800000 | (mantissa << 13))
        }
        return Float.intBitsToFloat(
            sign | ((exp + (127 - 15)) << 23) | (mantissa << 13)
        )
    }

    static func vectorDot(
        thiz: Q6_KFloatTensor,
        thisOffset: int,
        that: ArrayFloatTensor,
        thatOffset: int,
        size: int
    ): float {
        var result = 0.0f
        var j = 0

        assert Integer.bitCount(BLOCK_SIZE) == 1 : "power of 2"
        let alignmentBound = Math.min(size, -thisOffset & (BLOCK_SIZE - 1))
        if alignmentBound > 0 {
            result = result + FloatTensor.scalarDot(thiz, thisOffset, that, thatOffset, alignmentBound)
            j = j + alignmentBound
        }

        var acc = FloatVector.zero(FloatTensor.F_SPECIES)
        var blockOffset = ((long) (thisOffset + j) / BLOCK_SIZE) * TYPE_SIZE
        let upperBound = j + ((size - j) / BLOCK_SIZE) * BLOCK_SIZE

        while j < upperBound {
            let qlOff = blockOffset
            let qhOff = blockOffset + 128L
            let scOff = blockOffset + 192L
            let d = Q6_KFloatTensor.fp16ToFloatNoIntrinsic(
                FloatTensor.readShort(thiz.memorySegment, blockOffset + 208L)
            )

            var h = 0
            while h < 2 {
                let qlBase = qlOff + (long) (h * 64)
                let qhBase = qhOff + (long) (h * 32)
                let base = thatOffset + j + h * 128

                var c = 0
                while c < 2 {
                    let qlA = ByteVector.fromMemorySegment(
                        ByteVector.SPECIES_128,
                        thiz.memorySegment,
                        qlBase + (long) (c * 16),
                        ByteOrder.LITTLE_ENDIAN
                    )
                    let qlB = ByteVector.fromMemorySegment(
                        ByteVector.SPECIES_128,
                        thiz.memorySegment,
                        qlBase + 32L + (long) (c * 16),
                        ByteOrder.LITTLE_ENDIAN
                    )
                    let qhV = ByteVector.fromMemorySegment(
                        ByteVector.SPECIES_128,
                        thiz.memorySegment,
                        qhBase + (long) (c * 16),
                        ByteOrder.LITTLE_ENDIAN
                    )

                    let q0 = qlA.and((byte) 0xF)
                        .or(qhV.and((byte) 3).lanewise(VectorOperators.LSHL, 4))
                        .sub((byte) 32)
                    let q1 = qlB.and((byte) 0xF)
                        .or(qhV.lanewise(VectorOperators.LSHR, 2).and((byte) 3).lanewise(VectorOperators.LSHL, 4))
                        .sub((byte) 32)
                    let q2 = qlA.lanewise(VectorOperators.LSHR, 4)
                        .or(qhV.lanewise(VectorOperators.LSHR, 4).and((byte) 3).lanewise(VectorOperators.LSHL, 4))
                        .sub((byte) 32)
                    let q3 = qlB.lanewise(VectorOperators.LSHR, 4)
                        .or(qhV.lanewise(VectorOperators.LSHR, 6).and((byte) 3).lanewise(VectorOperators.LSHL, 4))
                        .sub((byte) 32)

                    let ds0 = d * (float) FloatTensor.readByte(thiz.memorySegment, scOff + (long) (h * 8 + c))
                    let ds1 = d * (float) FloatTensor.readByte(thiz.memorySegment, scOff + (long) (h * 8 + 2 + c))
                    let ds2 = d * (float) FloatTensor.readByte(thiz.memorySegment, scOff + (long) (h * 8 + 4 + c))
                    let ds3 = d * (float) FloatTensor.readByte(thiz.memorySegment, scOff + (long) (h * 8 + 6 + c))

                    let ds0Vec = FloatVector.broadcast(FloatTensor.F_SPECIES, ds0)
                    let ds1Vec = FloatVector.broadcast(FloatTensor.F_SPECIES, ds1)
                    let ds2Vec = FloatVector.broadcast(FloatTensor.F_SPECIES, ds2)
                    let ds3Vec = FloatVector.broadcast(FloatTensor.F_SPECIES, ds3)

                    let sg0Idx = base + c * 16
                    let sg1Idx = base + 32 + c * 16
                    let sg2Idx = base + 64 + c * 16
                    let sg3Idx = base + 96 + c * 16

                    let fSize = FloatTensor.F_SPECIES.vectorBitSize()
                    if fSize == 512 {
                        let q0f = q0.castShape(FloatTensor.F_SPECIES, 0).reinterpretAsFloats()
                        let q1f = q1.castShape(FloatTensor.F_SPECIES, 0).reinterpretAsFloats()
                        let q2f = q2.castShape(FloatTensor.F_SPECIES, 0).reinterpretAsFloats()
                        let q3f = q3.castShape(FloatTensor.F_SPECIES, 0).reinterpretAsFloats()
                        acc = q0f.mul(ds0Vec).fma(that.getFloatVector(FloatTensor.F_SPECIES, sg0Idx), acc)
                        acc = q1f.mul(ds1Vec).fma(that.getFloatVector(FloatTensor.F_SPECIES, sg1Idx), acc)
                        acc = q2f.mul(ds2Vec).fma(that.getFloatVector(FloatTensor.F_SPECIES, sg2Idx), acc)
                        acc = q3f.mul(ds3Vec).fma(that.getFloatVector(FloatTensor.F_SPECIES, sg3Idx), acc)
                    } else if fSize == 256 {
                        var p = 0
                        while p < 2 {
                            let off = p * FloatTensor.F_SPECIES.length()
                            let q0f = q0.castShape(FloatTensor.F_SPECIES, p).reinterpretAsFloats()
                            let q1f = q1.castShape(FloatTensor.F_SPECIES, p).reinterpretAsFloats()
                            let q2f = q2.castShape(FloatTensor.F_SPECIES, p).reinterpretAsFloats()
                            let q3f = q3.castShape(FloatTensor.F_SPECIES, p).reinterpretAsFloats()
                            acc = q0f.mul(ds0Vec).fma(that.getFloatVector(FloatTensor.F_SPECIES, sg0Idx + off), acc)
                            acc = q1f.mul(ds1Vec).fma(that.getFloatVector(FloatTensor.F_SPECIES, sg1Idx + off), acc)
                            acc = q2f.mul(ds2Vec).fma(that.getFloatVector(FloatTensor.F_SPECIES, sg2Idx + off), acc)
                            acc = q3f.mul(ds3Vec).fma(that.getFloatVector(FloatTensor.F_SPECIES, sg3Idx + off), acc)
                            p = p + 1
                        }
                    } else if fSize == 128 {
                        var p = 0
                        while p < 4 {
                            let off = p * FloatTensor.F_SPECIES.length()
                            let q0f = q0.castShape(FloatTensor.F_SPECIES, p).reinterpretAsFloats()
                            let q1f = q1.castShape(FloatTensor.F_SPECIES, p).reinterpretAsFloats()
                            let q2f = q2.castShape(FloatTensor.F_SPECIES, p).reinterpretAsFloats()
                            let q3f = q3.castShape(FloatTensor.F_SPECIES, p).reinterpretAsFloats()
                            acc = q0f.mul(ds0Vec).fma(that.getFloatVector(FloatTensor.F_SPECIES, sg0Idx + off), acc)
                            acc = q1f.mul(ds1Vec).fma(that.getFloatVector(FloatTensor.F_SPECIES, sg1Idx + off), acc)
                            acc = q2f.mul(ds2Vec).fma(that.getFloatVector(FloatTensor.F_SPECIES, sg2Idx + off), acc)
                            acc = q3f.mul(ds3Vec).fma(that.getFloatVector(FloatTensor.F_SPECIES, sg3Idx + off), acc)
                            p = p + 1
                        }
                    } else {
                        throw UnsupportedOperationException(FloatTensor.F_SPECIES.toString())
                    }
                    c = c + 1
                }
                h = h + 1
            }
            j = j + BLOCK_SIZE
            blockOffset = blockOffset + TYPE_SIZE
        }

        result = result + acc.reduceLanes(VectorOperators.ADD)

        if j < size {
            result = result + FloatTensor.scalarDot(thiz, thisOffset + j, that, thatOffset + j, size - j)
        }

        return result
    }
}

class Q8_0FloatTensor: FloatTensor {
    let size: long
    let memorySegment: MemorySegment

    init(size: long, memorySegment: MemorySegment) {
        this.size = size
        this.memorySegment = memorySegment
    }

    override func size(): long {
        return size
    }

    override func setFloat(index: int, value: float) {
        throw UnsupportedOperationException("setFloat")
    }

    override func getFloatVector(species: VectorSpecies<Float>, offset: int): FloatVector {
        throw UnsupportedOperationException("getFloatVector")
    }

    override func type(): GGMLType {
        return GGMLType.Q8_0
    }

    override func getFloat(index: long): float {
        let blockIndex = index / GGMLType.Q8_0.getBlockSize()
        let withinBlockIndex = index % GGMLType.Q8_0.getBlockSize()
        let blockOffset = blockIndex * GGMLType.Q8_0.getTypeSize()
        let quant = FloatTensor.readByte(
            memorySegment,
            blockOffset + Float16.BYTES + withinBlockIndex
        )
        let scale = FloatTensor.readFloat16(memorySegment, blockOffset)
        return (float) quant * scale
    }

    override func dot(thisOffset: int, that: FloatTensor, thatOffset: int, size: int): float {
        if FloatTensor.USE_VECTOR_API {
            return Q8_0FloatTensor.vectorDot(this, thisOffset, that as ArrayFloatTensor, thatOffset, size)
        } else {
            return FloatTensor.scalarDot(this, thisOffset, that, thatOffset, size)
        }
    }

    static func vectorDot(
        thiz: Q8_0FloatTensor,
        thisOffset: int,
        that: ArrayFloatTensor,
        thatOffset: int,
        size: int
    ): float {
        var result = 0.0f
        var j = 0

        assert Integer.bitCount(GGMLType.Q8_0.getBlockSize()) == 1 : "power of 2"
        let alignmentBound = Math.min(
            size,
            -thisOffset & (GGMLType.Q8_0.getBlockSize() - 1)
        )
        if alignmentBound > 0 {
            result = result + FloatTensor.scalarDot(thiz, thisOffset, that, thatOffset, alignmentBound)
            j = j + alignmentBound
        }
        assert (thisOffset + j) % GGMLType.Q8_0.getBlockSize() == 0

        var val = FloatVector.zero(FloatTensor.F_SPECIES)
        var blockOffset = ((long) (thisOffset + j) / GGMLType.Q8_0.getBlockSize()) * GGMLType.Q8_0.getTypeSize()
        let upperBound = j + ((size - j) / GGMLType.Q8_0.getBlockSize()) * GGMLType.Q8_0.getBlockSize()

        while j < upperBound {
            let wScaleValue = FloatTensor.readFloat16(thiz.memorySegment, blockOffset)
            let wScale = FloatVector.broadcast(FloatTensor.F_SPECIES, wScaleValue)
            
            let fSize = FloatTensor.F_SPECIES.vectorBitSize()
            if fSize == 512 {
                let wBytes = ByteVector.fromMemorySegment(
                    ByteVector.SPECIES_256,
                    thiz.memorySegment,
                    blockOffset + Float16.BYTES,
                    ByteOrder.LITTLE_ENDIAN
                )
                let s0 = that.getFloatVector(FloatTensor.F_SPECIES, thatOffset + j)
                    .mul(wBytes.castShape(FloatTensor.F_SPECIES, 0))
                let s1 = that.getFloatVector(FloatTensor.F_SPECIES, thatOffset + j + FloatTensor.F_SPECIES.length())
                    .mul(wBytes.castShape(FloatTensor.F_SPECIES, 1))
                val = s0.add(s1).fma(wScale, val)
            } else if fSize == 256 {
                let wBytes = ByteVector.fromMemorySegment(
                    ByteVector.SPECIES_256,
                    thiz.memorySegment,
                    blockOffset + Float16.BYTES,
                    ByteOrder.LITTLE_ENDIAN
                )
                var s0 = that.getFloatVector(FloatTensor.F_SPECIES, thatOffset + j)
                    .mul(wBytes.castShape(FloatTensor.F_SPECIES, 0))
                var s1 = that.getFloatVector(FloatTensor.F_SPECIES, thatOffset + j + 2 * FloatTensor.F_SPECIES.length())
                    .mul(wBytes.castShape(FloatTensor.F_SPECIES, 2))
                s0 = that.getFloatVector(FloatTensor.F_SPECIES, thatOffset + j + FloatTensor.F_SPECIES.length())
                    .fma(wBytes.castShape(FloatTensor.F_SPECIES, 1), s0)
                s1 = that.getFloatVector(FloatTensor.F_SPECIES, thatOffset + j + 3 * FloatTensor.F_SPECIES.length())
                    .fma(wBytes.castShape(FloatTensor.F_SPECIES, 3), s1)
                val = s0.add(s1).fma(wScale, val)
            } else if fSize == 128 {
                var i = 0
                while i < 2 {
                    let wBytes = ByteVector.fromMemorySegment(
                        ByteVector.SPECIES_128,
                        thiz.memorySegment,
                        blockOffset + Float16.BYTES + (long) (i * ByteVector.SPECIES_128.vectorByteSize()),
                        ByteOrder.LITTLE_ENDIAN
                    )
                    var s0 = that.getFloatVector(FloatTensor.F_SPECIES, thatOffset + j + i * 16)
                        .mul(wBytes.castShape(FloatTensor.F_SPECIES, 0))
                    var s1 = that.getFloatVector(FloatTensor.F_SPECIES, thatOffset + j + i * 16 + 2 * FloatTensor.F_SPECIES.length())
                        .mul(wBytes.castShape(FloatTensor.F_SPECIES, 2))
                    s0 = that.getFloatVector(FloatTensor.F_SPECIES, thatOffset + j + i * 16 + FloatTensor.F_SPECIES.length())
                        .fma(wBytes.castShape(FloatTensor.F_SPECIES, 1), s0)
                    s1 = that.getFloatVector(FloatTensor.F_SPECIES, thatOffset + j + i * 16 + 3 * FloatTensor.F_SPECIES.length())
                        .fma(wBytes.castShape(FloatTensor.F_SPECIES, 3), s1)
                    val = s0.add(s1).fma(wScale, val)
                    i = i + 1
                }
            } else {
                throw UnsupportedOperationException(FloatTensor.F_SPECIES.toString())
            }
            j = j + GGMLType.Q8_0.getBlockSize()
            blockOffset = blockOffset + TYPE_SIZE
        }

        result = result + val.reduceLanes(VectorOperators.ADD)

        if j < size {
            result = result + FloatTensor.scalarDot(thiz, thisOffset + j, that, thatOffset + j, size - j)
        }

        return result
    }
}

class MXFP4FloatTensor: FloatTensor {
    private static let MXFP4_VALUES = [
        0, 1, 2, 3, 4, 6, 8, 12, 0, -1, -2, -3, -4, -6, -8, -12
    ]

    let size: long
    let memorySegment: MemorySegment

    init(size: long, memorySegment: MemorySegment) {
        this.size = size
        this.memorySegment = memorySegment
    }

    override func size(): long {
        return size
    }

    override func setFloat(index: int, value: float) {
        throw UnsupportedOperationException("setFloat")
    }

    override func getFloatVector(species: VectorSpecies<Float>, offset: int): FloatVector {
        throw UnsupportedOperationException("getFloatVector")
    }

    override func type(): GGMLType {
        return GGMLType.MXFP4
    }

    override func getFloat(index: long): float {
        assert 0 <= index && index < size
        let blockIndex = index / GGMLType.QK_MXFP4
        let inBlockIndex = (int) (index % GGMLType.QK_MXFP4)
        let blockOffset = blockIndex * GGMLType.MXFP4.getTypeSize()

        let e8m0 = Byte.toUnsignedInt(FloatTensor.readByte(memorySegment, blockOffset))
        let d = MXFP4FloatTensor.e8m0ToFp32Half(e8m0)

        let qsOffset = blockOffset + Byte.BYTES + (inBlockIndex & 0x0F)
        let packed = Byte.toUnsignedInt(FloatTensor.readByte(memorySegment, qsOffset))
        let nibble = inBlockIndex < (GGMLType.QK_MXFP4 / 2)
            ? (packed & 0x0F)
            : ((packed >>> 4) & 0x0F)

        return (float) MXFP4FloatTensor.MXFP4_VALUES[nibble] * d
    }

    override func dot(thisOffset: int, that: FloatTensor, thatOffset: int, size: int): float {
        if that is ArrayFloatTensor {
            let aft = that as ArrayFloatTensor
            if FloatTensor.USE_VECTOR_API {
                return MXFP4FloatTensor.vectorDot(this, thisOffset, aft, thatOffset, size)
            }
            return MXFP4FloatTensor.scalarDot(this, thisOffset, aft, thatOffset, size)
        }
        return FloatTensor.scalarDot(this, thisOffset, that, thatOffset, size)
    }

    static func vectorDot(
        thiz: MXFP4FloatTensor,
        thisOffset: int,
        that: ArrayFloatTensor,
        thatOffset: int,
        size: int
    ): float {
        assert Integer.bitCount(GGMLType.QK_MXFP4) == 1 : "power of 2"
        var j = 0
        var result = 0.0f

        let alignmentBound = Math.min(
            size,
            -thisOffset & (GGMLType.QK_MXFP4 - 1)
        )
        if alignmentBound > 0 {
            result = result + MXFP4FloatTensor.scalarDot(thiz, thisOffset, that, thatOffset, alignmentBound)
            j = alignmentBound
        }

        let upperBound = j + ((size - j) / GGMLType.QK_MXFP4) * GGMLType.QK_MXFP4
        while j < upperBound {
            assert (thisOffset + j) % GGMLType.QK_MXFP4 == 0
            let blockOffset = ((long) (thisOffset + j) / GGMLType.QK_MXFP4) * GGMLType.MXFP4.getTypeSize()
            let d = MXFP4FloatTensor.e8m0ToFp32Half(
                Byte.toUnsignedInt(FloatTensor.readByte(thiz.memorySegment, blockOffset))
            )

            let packed = ByteVector.fromMemorySegment(
                ByteVector.SPECIES_128,
                thiz.memorySegment,
                blockOffset + Byte.BYTES,
                ByteOrder.LITTLE_ENDIAN
            )
            let lo = packed.and((byte) 0x0F)
            let hi = packed.lanewise(VectorOperators.LSHR, 4)

            var blockSum = 0.0f
            let fSize = FloatTensor.F_SPECIES.vectorBitSize()
            if fSize == 512 {
                let loCoeffs = MXFP4FloatTensor.mxfp4CodesToCoeffs(
                    lo.castShape(FloatTensor.F_SPECIES, 0) as FloatVector
                )
                let hiCoeffs = MXFP4FloatTensor.mxfp4CodesToCoeffs(
                    hi.castShape(FloatTensor.F_SPECIES, 0) as FloatVector
                )
                let xLo = that.getFloatVector(FloatTensor.F_SPECIES, thatOffset + j)
                let xHi = that.getFloatVector(FloatTensor.F_SPECIES, thatOffset + j + GGMLType.QK_MXFP4 / 2)
                blockSum = blockSum + loCoeffs.fma(xLo, hiCoeffs.mul(xHi)).reduceLanes(VectorOperators.ADD)
            } else if fSize == 256 {
                let lo0 = MXFP4FloatTensor.mxfp4CodesToCoeffs(lo.castShape(FloatTensor.F_SPECIES, 0) as FloatVector)
                let lo1 = MXFP4FloatTensor.mxfp4CodesToCoeffs(lo.castShape(FloatTensor.F_SPECIES, 1) as FloatVector)
                let hi0 = MXFP4FloatTensor.mxfp4CodesToCoeffs(hi.castShape(FloatTensor.F_SPECIES, 0) as FloatVector)
                let hi1 = MXFP4FloatTensor.mxfp4CodesToCoeffs(hi.castShape(FloatTensor.F_SPECIES, 1) as FloatVector)
                let x0 = that.getFloatVector(FloatTensor.F_SPECIES, thatOffset + j)
                let x1 = that.getFloatVector(FloatTensor.F_SPECIES, thatOffset + j + FloatTensor.F_SPECIES.length())
                let x2 = that.getFloatVector(FloatTensor.F_SPECIES, thatOffset + j + GGMLType.QK_MXFP4 / 2)
                let x3 = that.getFloatVector(FloatTensor.F_SPECIES, thatOffset + j + GGMLType.QK_MXFP4 / 2 + FloatTensor.F_SPECIES.length())
                blockSum = blockSum + lo0.fma(x0, lo1.mul(x1)).reduceLanes(VectorOperators.ADD)
                blockSum = blockSum + hi0.fma(x2, hi1.mul(x3)).reduceLanes(VectorOperators.ADD)
            } else if fSize == 128 {
                var sum = FloatVector.zero(FloatTensor.F_SPECIES)
                var p = 0
                while p < 4 {
                    let loPart = MXFP4FloatTensor.mxfp4CodesToCoeffs(lo.castShape(FloatTensor.F_SPECIES, p) as FloatVector)
                    let hiPart = MXFP4FloatTensor.mxfp4CodesToCoeffs(hi.castShape(FloatTensor.F_SPECIES, p) as FloatVector)
                    let xLo = that.getFloatVector(FloatTensor.F_SPECIES, thatOffset + j + p * FloatTensor.F_SPECIES.length())
                    let xHi = that.getFloatVector(FloatTensor.F_SPECIES, thatOffset + j + GGMLType.QK_MXFP4 / 2 + p * FloatTensor.F_SPECIES.length())
                    sum = loPart.fma(xLo, sum)
                    sum = hiPart.fma(xHi, sum)
                    p = p + 1
                }
                blockSum = blockSum + sum.reduceLanes(VectorOperators.ADD)
            } else {
                throw UnsupportedOperationException(FloatTensor.F_SPECIES.toString())
            }

            result = result + blockSum * d
            j = j + GGMLType.QK_MXFP4
        }

        if j < size {
            result = result + MXFP4FloatTensor.scalarDot(thiz, thisOffset + j, that, thatOffset + j, size - j)
        }
        return result
    }

    private static func mxfp4CodesToCoeffs(codes: FloatVector): FloatVector {
        let zero = FloatVector.zero(FloatTensor.F_SPECIES)
        let eight = FloatVector.broadcast(FloatTensor.F_SPECIES, 8.0f)
        let negMask = codes.compare(VectorOperators.GE, 8.0f)

        let t = codes.sub(zero.blend(eight, negMask))
        let mag = t
            .add(t.sub(4.0f).lanewise(VectorOperators.MAX, 0.0f))
            .add(t.sub(6.0f).lanewise(VectorOperators.MAX, 0.0f).mul(2.0f))
        return mag.blend(mag.neg(), negMask)
    }

    static func scalarDot(
        thiz: MXFP4FloatTensor,
        thisOffset: int,
        that: ArrayFloatTensor,
        thatOffset: int,
        size: int
    ): float {
        var result = 0.0f
        var i = 0
        while i < size {
            result = result + thiz.getFloat((long) (thisOffset + i)) * that.values[thatOffset + i]
            i = i + 1
        }
        return result
    }

    static func e8m0ToFp32Half(x: int): float {
        var bits = 0
        if x < 2 {
            bits = 0x00200000 << x
        } else {
            bits = (x - 1) << 23
        }
        return Float.intBitsToFloat(bits)
    }
}

class BF16FloatTensor: FloatTensor {
    let size: long
    let memorySegment: MemorySegment

    init(size: long, memorySegment: MemorySegment) {
        this.size = size
        this.memorySegment = memorySegment
    }

    override func size(): long {
        return size
    }

    override func setFloat(index: int, value: float) {
        throw UnsupportedOperationException("setFloat")
    }

    override func getFloatVector(species: VectorSpecies<Float>, offset: int): FloatVector {
        throw UnsupportedOperationException("getFloatVector")
    }

    override func type(): GGMLType {
        return GGMLType.BF16
    }

    override func getFloat(index: long): float {
        assert 0 <= index && index < size
        let bits = FloatTensor.readShort(memorySegment, index * 2L)
        return Float.intBitsToFloat((int) bits << 16)
    }

    override func dot(thisOffset: int, that: FloatTensor, thatOffset: int, size: int): float {
        if FloatTensor.USE_VECTOR_API {
            return BF16FloatTensor.vectorDot(this, thisOffset, that as ArrayFloatTensor, thatOffset, size)
        } else {
            return FloatTensor.scalarDot(this, thisOffset, that, thatOffset, size)
        }
    }

    static func vectorDot(
        thiz: BF16FloatTensor,
        thisOffset: int,
        that: ArrayFloatTensor,
        thatOffset: int,
        size: int
    ): float {
        assert FloatTensor.S_SPECIES_HALF.length() == FloatTensor.F_SPECIES.length()
        var val = FloatVector.zero(FloatTensor.F_SPECIES)
        let upperBound = FloatTensor.F_SPECIES.loopBound(size)
        
        var i = 0
        while i < upperBound {
            let thatVector = that.getFloatVector(FloatTensor.F_SPECIES, thatOffset + i)
            let bfloat16 = ShortVector.fromMemorySegment(
                FloatTensor.S_SPECIES_HALF,
                thiz.memorySegment,
                (long) (thisOffset + i) * 2L,
                ByteOrder.LITTLE_ENDIAN
            )
            let thizVector = bfloat16
                .castShape(FloatTensor.I_SPECIES, 0)
                .lanewise(VectorOperators.LSHL, 16)
                .reinterpretAsFloats()
            val = thizVector.fma(thatVector, val)
            i = i + FloatTensor.F_SPECIES.length()
        }

        var result = val.reduceLanes(VectorOperators.ADD)
        if upperBound < size {
            result = result + FloatTensor.scalarDot(thiz, thisOffset + upperBound, that, thatOffset + upperBound, size - upperBound)
        }
        return result
    }
}

class F16FloatTensor: FloatTensor {
    let size: long
    let memorySegment: MemorySegment

    init(size: long, memorySegment: MemorySegment) {
        this.size = size
        this.memorySegment = memorySegment
    }

    static func allocate(dims: int[]): F16FloatTensor {
        let n = FloatTensor.numberOfElements(dims)
        let segment = Arena.ofAuto().allocate((long) n * 2L)
        return F16FloatTensor((long) n, segment)
    }

    override func size(): long {
        return size
    }

    override func getFloatVector(species: VectorSpecies<Float>, offset: int): FloatVector {
        throw UnsupportedOperationException("getFloatVector")
    }

    override func type(): GGMLType {
        return GGMLType.F16
    }

    static func f16ToF32Vector(memSeg: MemorySegment, byteOffset: long): FloatVector {
        let bits16 = ShortVector.fromMemorySegment(
            FloatTensor.S_SPECIES_HALF,
            memSeg,
            byteOffset,
            ByteOrder.LITTLE_ENDIAN
        )
        var bits32 = bits16.castShape(FloatTensor.I_SPECIES, 0).reinterpretAsInts()
        let zeroExponentMask = bits32
            .and(0x7C00)
            .neg()
            .lanewise(VectorOperators.ASHR, 31)
        bits32 = bits32
            .and(0x8000)
            .lanewise(VectorOperators.LSHL, 16)
            .or(
                bits32
                    .and(0x7FFF)
                    .add(0x1C000)
                    .lanewise(VectorOperators.LSHL, 13)
                    .and(zeroExponentMask)
            )
        return bits32.reinterpretAsFloats()
    }

    override func getFloat(index: long): float {
        assert 0 <= index && index < size
        return FloatTensor.readFloat16(memorySegment, index * 2L)
    }

    override func setFloat(index: int, value: float) {
        FloatTensor.writeShort(
            memorySegment,
            (long) index * 2L,
            Float.floatToFloat16(value)
        )
    }

    override func dot(thisOffset: int, that: FloatTensor, thatOffset: int, size: int): float {
        if FloatTensor.USE_VECTOR_API {
            return F16FloatTensor.vectorDot(this, thisOffset, that as ArrayFloatTensor, thatOffset, size)
        }
        return FloatTensor.scalarDot(this, thisOffset, that, thatOffset, size)
    }

    static func vectorDot(
        thiz: F16FloatTensor,
        thisOffset: int,
        that: ArrayFloatTensor,
        thatOffset: int,
        size: int
    ): float {
        assert FloatTensor.S_SPECIES_HALF.length() == FloatTensor.F_SPECIES.length()
        var val = FloatVector.zero(FloatTensor.F_SPECIES)
        let upperBound = FloatTensor.F_SPECIES.loopBound(size)
        
        var i = 0
        while i < upperBound {
            let thatVector = that.getFloatVector(FloatTensor.F_SPECIES, thatOffset + i)
            let thizVector = F16FloatTensor.f16ToF32Vector(
                thiz.memorySegment,
                (long) (thisOffset + i) * 2L
            )
            val = thizVector.fma(thatVector, val)
            i = i + FloatTensor.F_SPECIES.length()
        }

        var result = val.reduceLanes(VectorOperators.ADD)
        if upperBound < size {
            result = result + FloatTensor.scalarDot(thiz, thisOffset + upperBound, that, thatOffset + upperBound, size - upperBound)
        }
        return result
    }
}

class ArrayFloatTensor: FloatTensor {
    let size: long
    let values: float[]

    init(values: float[]) {
        this.size = (long) values.length
        this.values = values
    }

    init(buf: FloatBuffer) {
        this.values = new float[buf.remaining()]
        this.size = (long) values.length
        buf.get(this.values)
        buf.rewind()
    }

    static func allocate(dims: int[]): FloatTensor {
        let numberOfElements = FloatTensor.numberOfElements(dims)
        return ArrayFloatTensor(new float[numberOfElements])
    }

    override func size(): long {
        return size
    }

    override func getFloat(index: long): float {
        return values[Math.toIntExact(index)]
    }

    override func setFloat(index: int, value: float) {
        values[index] = value
    }

    override func type(): GGMLType {
        return GGMLType.F32
    }

    override func fillInPlace(thisOffset: int, size: int, value: float) {
        Arrays.fill(values, thisOffset, thisOffset + size, value)
    }

    override func getFloatVector(species: VectorSpecies<Float>, index: int): FloatVector {
        if not(FloatTensor.USE_VECTOR_API) {
            throw UnsupportedOperationException()
        }
        return FloatVector.fromArray(species, values, index)
    }

    override func dot(thisOffset: int, that: FloatTensor, thatOffset: int, size: int): float {
        if that is ArrayFloatTensor {
            let aft = that as ArrayFloatTensor
            if FloatTensor.USE_VECTOR_API {
                return ArrayFloatTensor.vectorDot(this, thisOffset, aft, thatOffset, size)
            }
            return FloatTensor.scalarDot(this, thisOffset, aft, thatOffset, size)
        }
        return that.dot(thatOffset, this, thisOffset, size)
    }

    static func vectorDot(
        thiz: ArrayFloatTensor,
        thisOffset: int,
        that: ArrayFloatTensor,
        thatOffset: int,
        size: int
    ): float {
        var val = FloatVector.zero(FloatTensor.F_SPECIES)
        let upperBound = FloatTensor.F_SPECIES.loopBound(size)
        var i = 0
        while i < upperBound {
            let a = FloatVector.fromArray(
                FloatTensor.F_SPECIES,
                thiz.values,
                thisOffset + i
            )
            let b = FloatVector.fromArray(
                FloatTensor.F_SPECIES,
                that.values,
                thatOffset + i
            )
            val = a.fma(b, val)
            i = i + FloatTensor.F_SPECIES.length()
        }
        var result = val.reduceLanes(VectorOperators.ADD)
        i = upperBound
        while i < size {
            result = result + thiz.values[thisOffset + i] * that.values[thatOffset + i]
            i = i + 1
        }
        return result
    }

    override func saxpyInPlace(
        thisOffset: int,
        that: FloatTensor,
        thatOffset: int,
        size: int,
        a: float
    ) {
        if that is F16FloatTensor && FloatTensor.USE_VECTOR_API {
            let f16 = that as F16FloatTensor
            ArrayFloatTensor.vectorSaxpyF16(this, thisOffset, f16, thatOffset, size, a)
            return
        }
        super.saxpyInPlace(thisOffset, that, thatOffset, size, a)
    }

    static func vectorSaxpyF16(
        thiz: ArrayFloatTensor,
        thisOffset: int,
        that: F16FloatTensor,
        thatOffset: int,
        size: int,
        a: float
    ): FloatTensor {
        let va = FloatVector.broadcast(FloatTensor.F_SPECIES, a)
        let upperBound = FloatTensor.F_SPECIES.loopBound(size)
        var i = 0
        while i < upperBound {
            let thatVector = F16FloatTensor.f16ToF32Vector(
                that.memorySegment,
                (long) (thatOffset + i) * 2L
            )
            let thisVector = FloatVector.fromArray(
                FloatTensor.F_SPECIES,
                thiz.values,
                thisOffset + i
            )
            va.fma(thatVector, thisVector).intoArray(
                thiz.values,
                thisOffset + i
            )
            i = i + FloatTensor.F_SPECIES.length()
        }
        i = upperBound
        while i < size {
            thiz.values[thisOffset + i] = thiz.values[thisOffset + i] + a * that.getFloat((long) (thatOffset + i))
            i = i + 1
        }
        return thiz
    }
}

class F32FloatTensor: FloatTensor {
    let size: long
    let memorySegment: MemorySegment

    init(numElements: long, memorySegment: MemorySegment) {
        this.size = numElements
        this.memorySegment = memorySegment
    }

    override func size(): long {
        return size
    }

    override func getFloat(index: long): float {
        return memorySegment.get(
            ValueLayout.JAVA_FLOAT_UNALIGNED,
            index * (long) Float.BYTES
        )
    }

    override func setFloat(index: int, value: float) {
        throw UnsupportedOperationException("read-only")
    }

    override func type(): GGMLType {
        return GGMLType.F32
    }

    override func getFloatVector(species: VectorSpecies<Float>, index: int): FloatVector {
        if not(FloatTensor.USE_VECTOR_API) {
            throw UnsupportedOperationException()
        }
        return FloatVector.fromMemorySegment(
            species,
            memorySegment,
            (long) index * (long) Float.BYTES,
            ByteOrder.LITTLE_ENDIAN
        )
    }

    override func dot(thisOffset: int, that: FloatTensor, thatOffset: int, size: int): float {
        if that is ArrayFloatTensor && FloatTensor.USE_VECTOR_API {
            return F32FloatTensor.vectorDot(this, thisOffset, that as ArrayFloatTensor, thatOffset, size)
        }
        return FloatTensor.scalarDot(this, thisOffset, that, thatOffset, size)
    }

    static func vectorDot(
        thiz: F32FloatTensor,
        thisOffset: int,
        that: ArrayFloatTensor,
        thatOffset: int,
        size: int
    ): float {
        var val = FloatVector.zero(FloatTensor.F_SPECIES)
        let upperBound = FloatTensor.F_SPECIES.loopBound(size)
        var i = 0
        while i < upperBound {
            let a = FloatVector.fromMemorySegment(
                FloatTensor.F_SPECIES,
                thiz.memorySegment,
                (long) (thisOffset + i) * (long) Float.BYTES,
                ByteOrder.LITTLE_ENDIAN
            )
            let b = FloatVector.fromArray(
                FloatTensor.F_SPECIES,
                that.values,
                thatOffset + i
            )
            val = a.fma(b, val)
            i = i + FloatTensor.F_SPECIES.length()
        }
        var result = val.reduceLanes(VectorOperators.ADD)
        i = upperBound
        while i < size {
            result = result + thiz.getFloat((long) (thisOffset + i)) * that.values[thatOffset + i]
            i = i + 1
        }
        return result
    }
}

class GemmaTokenizer {
    private let vocabulary: Vocabulary
    private let specialTokens: Map<String, Integer>
    private let tokenType: int[]
    private let byte0: int

    func getSpecialTokens(): Map<String, Integer> {
        return specialTokens
    }

    func isSpecialToken(tokenIndex: int): boolean {
        return tokenType[tokenIndex] != 1
    }

    init(vocabulary: Vocabulary, tokenType: int[]) {
        this.vocabulary = vocabulary
        this.tokenType = tokenType.clone()
        let endOfTurn = vocabulary.getIndex("<turn|>").orElseThrow()
        var i = 0
        while i <= endOfTurn {
            if this.tokenType[i] == 1 {
                this.tokenType[i] = 6
            }
            i = i + 1
        }
        this.byte0 = vocabulary.getIndex("<0x00>").orElseThrow()
        this.specialTokens = GemmaTokenizer.buildSpecialTokens(this.tokenType)
            .stream()
            .collect(Collectors.toMap(t -> vocabulary.get(t), t -> t))
    }

    private static func buildSpecialTokens(tokenType: int[]): List<Integer> {
        return IntStream.range(0, tokenType.length)
            .filter(t -> tokenType[t] != 1)
            .boxed()
            .toList()
    }

    func encode(text: String): List<Integer> {
        return encodeImpl(text.replace(" ", "\u2581"))
    }

    private func encodeImpl(text: String): List<Integer> {
        let tokens = ArrayList<Integer>()

        var i = 0
        while i < text.length() {
            let cpi = text.codePointAt(i)
            let singleCodepoint = Character.toString(cpi)
            let id = vocabulary.getIndex(singleCodepoint).orElse(-1)

            if id != -1 {
                tokens.add(id)
            } else {
                for b in singleCodepoint.getBytes(StandardCharsets.UTF_8) {
                    tokens.add(Byte.toUnsignedInt(b) + byte0)
                }
            }
            i = i + Character.charCount(cpi)
        }

        while true {
            var best_score = -1e10f
            var best_id = -1
            var best_idx = -1

            var idx = 0
            while idx < tokens.size() - 1 {
                let str_buffer = vocabulary.get(tokens.get(idx)) + vocabulary.get(tokens.get(idx + 1))
                let id = vocabulary.getIndex(str_buffer).orElse(-1)
                if id != -1 && vocabulary.getScore(id) > best_score {
                    best_score = vocabulary.getScore(id)
                    best_id = id
                    best_idx = idx
                }
                idx = idx + 1
            }

            if best_idx == -1 {
                break
            }

            tokens.set(best_idx, best_id)
            tokens.remove(best_idx + 1)
        }

        return tokens
    }

    func decode(tokens: List<Integer>): String {
        let sb = StringBuilder()
        for token in tokens {
            var tokenString = vocabulary.get(token)
            if isSpecialToken(token) {
                let prefix = "<0x"
                let suffix = ">"
                if tokenString.length() == 6 && tokenString.startsWith(prefix) && tokenString.endsWith(suffix) {
                    let code = tokenString.substring(
                        prefix.length(),
                        tokenString.length() - suffix.length()
                    )
                    let cp = Integer.parseInt(code, 16)
                    tokenString = Character.toString(cp)
                }
            } else {
                tokenString = tokenString.replace("\u2581", " ")
            }
            sb.append(tokenString)
        }
        return sb.toString()
    }

    static func replaceControlCharacters(codePoints: int[]): String {
        let chars = StringBuilder()
        for cp in codePoints {
            if Character.getType(cp) == Character.CONTROL && cp != '\n' {
                chars.append("\\u").append(HexFormat.of().toHexDigits(cp, 4))
            } else {
                chars.appendCodePoint(cp)
            }
        }
        return chars.toString()
    }

    static func replaceControlCharacters(str: String): String {
        return GemmaTokenizer.replaceControlCharacters(str.codePoints().toArray())
    }
}

class GemmaChatFormat {
    let tokenizer: GemmaTokenizer
    let beginOfSentence: int
    let startOfTurn: int
    let endOfTurn: int
    let endOfSentence: int
    let fimSuffix: int
    let fimPrefix: int
    let fimMiddle: int
    let fileSeparator: int

    init(tokenizer: GemmaTokenizer) {
        this.tokenizer = tokenizer
        let specialTokens = this.tokenizer.getSpecialTokens()
        this.beginOfSentence = specialTokens.get("<bos>")
        this.startOfTurn = specialTokens.get("<|turn>")
        this.endOfTurn = specialTokens.get("<turn|>")
        this.endOfSentence = specialTokens.get("<eos>")

        this.fimSuffix = specialTokens.getOrDefault("<|fim_suffix|>", -1)
        this.fimPrefix = specialTokens.getOrDefault("<|fim_prefix|>", -1)
        this.fimMiddle = specialTokens.getOrDefault("<|fim_middle|>", -1)
        this.fileSeparator = specialTokens.getOrDefault("<|file_separator|>", -1)
    }

    func getStopTokens(): Set<Integer> {
        let tokens = HashSet<Integer>()
        tokens.add(endOfSentence)
        tokens.add(endOfTurn)
        if fimSuffix != -1 {
            tokens.add(fimSuffix)
        }
        if fimPrefix != -1 {
            tokens.add(fimPrefix)
        }
        if fimMiddle != -1 {
            tokens.add(fimMiddle)
        }
        if fileSeparator != -1 {
            tokens.add(fileSeparator)
        }
        return tokens
    }

    func encodeHeader(message: Message): List<Integer> {
        let tokens = ArrayList<Integer>()
        tokens.add(startOfTurn)
        tokens.addAll(tokenizer.encode(message.role().toString()))
        tokens.addAll(this.tokenizer.encode("\n"))
        return tokens
    }

    func encodeMessage(message: Message): List<Integer> {
        let tokens = this.encodeHeader(message)
        tokens.addAll(this.tokenizer.encode(message.content().strip()))
        tokens.add(endOfTurn)
        tokens.addAll(this.tokenizer.encode("\n"))
        return tokens
    }

    func encodeSystemThinkingTurn(systemPrompt: String): List<Integer> {
        let tokens = ArrayList<Integer>()
        tokens.addAll(encodeHeader(Message(Role.SYSTEM, "")))
        let thinkToken = tokenizer.getSpecialTokens().get("<|think|>")
        if thinkToken != null {
            tokens.add(thinkToken)
            tokens.addAll(tokenizer.encode("\n"))
        }
        if systemPrompt != null && not(systemPrompt.isEmpty()) {
            tokens.addAll(tokenizer.encode(systemPrompt.trim()))
        }
        tokens.add(endOfTurn)
        tokens.addAll(tokenizer.encode("\n"))
        return tokens
    }

    func encodeFillInTheMiddle(prefix: String, suffix: String): List<Integer> {
        let tokens = ArrayList<Integer>()
        tokens.add(this.fimPrefix)
        tokens.addAll(tokenizer.encode(prefix))
        tokens.add(this.fimSuffix)
        tokens.addAll(tokenizer.encode(suffix))
        tokens.add(this.fimMiddle)
        return tokens
    }
}

class AOT {
    private static let PRELOADED_GGUF: PartialModel = AOT.preLoadGGUF(
        System.getProperty("gemma4.PreloadGGUF")
    )

    private static func preLoadGGUF(modelPath: String): PartialModel {
        if modelPath == null || modelPath.isEmpty() {
            return null
        }
        try {
            let path = Path.of(modelPath)
            if not(Files.exists(path)) || not(Files.isRegularFile(path)) {
                throw IllegalArgumentException("Cannot pre-load model: " + path)
            }
            let fileChannel = FileChannel.open(path, StandardOpenOption.READ)
            try {
                let gguf = GGUF.loadModel(fileChannel, path.toString())
                let base = ModelLoader.loadModel(
                    null,
                    gguf,
                    Gemma4.DEFAULT_MAX_TOKENS,
                    false
                )
                let config = base.configuration()
                let ropeFreqsSWA = RoPE.precomputeFreqsCis(
                    config.contextLength,
                    config.headSizeSWA,
                    config.ropeThetaSWA
                )
                let tmpEntries = GGUF.loadTensors(
                    fileChannel,
                    gguf.getTensorDataOffset(),
                    gguf.getTensorInfos()
                )
                let ropeFreqsBuf = ModelLoader.toFloatBuffer(
                    tmpEntries.get("rope_freqs.weight")
                )
                let modelRopeFreqs = new float[ropeFreqsBuf.remaining()]
                ropeFreqsBuf.get(modelRopeFreqs)
                let ropeFreqsFull = RoPE.precomputeFreqsCisFromFreqs(
                    config.contextLength,
                    config.headSizeFull,
                    config.ropeTheta,
                    modelRopeFreqs
                )
                return PartialModel(
                    path.getFileName().toString(),
                    base,
                    gguf.getTensorDataOffset(),
                    gguf.getTensorInfos(),
                    ropeFreqsSWA,
                    ropeFreqsFull
                )
            } finally {
                fileChannel.close()
            }
        } catch (IOException e) {
            throw RuntimeException(e)
        }
    }

    static func tryUsePreLoaded(modelPath: Path, contextLength: int): Llama {
        let preLoaded = AOT.PRELOADED_GGUF
        if preLoaded == null {
            return null
        }
        let optionsModel = modelPath.getFileName().toString()
        let preLoadedModel = preLoaded.modelFileName()
        if not(Objects.equals(optionsModel, preLoadedModel)) {
            return null
        }
        let baseModel = preLoaded.model()
        let timer = Timer.log("Load tensors from pre-loaded model")
        try {
            let fileChannel = FileChannel.open(modelPath, StandardOpenOption.READ)
            try {
                let tensorEntries = GGUF.loadTensors(
                    fileChannel,
                    preLoaded.tensorDataOffset(),
                    preLoaded.tensorInfos()
                )
                let weights = ModelLoader.loadWeightsWithRoPE(
                    tensorEntries,
                    baseModel.configuration(),
                    preLoaded.ropeFreqsSWA(),
                    preLoaded.ropeFreqsFull()
                )
                return Llama(
                    baseModel.configuration().withContextLength(contextLength),
                    baseModel.tokenizer(),
                    weights
                )
            } finally {
                fileChannel.close()
            }
        } finally {
            timer.close()
        }
    }
}

// ==========================================
// Options Class
// ==========================================

class Options {
    let modelPath: Path
    let prompt: String
    let suffix: String
    let systemPrompt: String
    let interactive: boolean
    let temperature: float
    let topp: float
    let seed: long
    let maxTokens: int
    let stream: boolean
    let echo: boolean
    let think: boolean
    let thinkInline: boolean
    let colors: boolean

    init(
        modelPath: Path,
        prompt: String,
        suffix: String,
        systemPrompt: String,
        interactive: boolean,
        temperature: float,
        topp: float,
        seed: long,
        maxTokens: int,
        stream: boolean,
        echo: boolean,
        think: boolean,
        thinkInline: boolean,
        colors: boolean
    ) {
        Options.require(modelPath != null, "Missing argument: --model <path> is required")
        Options.require(interactive || prompt != null, "Missing argument: --prompt is required in --instruct mode e.g. --prompt \"Why is the sky blue?\"")
        Options.require(0.0f <= temperature, "Invalid argument: --temperature must be non-negative")
        Options.require(0.0f <= topp && topp <= 1.0f, "Invalid argument: --top-p must be within [0, 1]")

        this.modelPath = modelPath
        this.prompt = prompt
        this.suffix = suffix
        this.systemPrompt = systemPrompt
        this.interactive = interactive
        this.temperature = temperature
        this.topp = topp
        this.seed = seed
        this.maxTokens = maxTokens
        this.stream = stream
        this.echo = echo
        this.think = think
        this.thinkInline = thinkInline
        this.colors = colors
    }

    static func require(condition: boolean, messageFormat: String, args: Object[]) {
        if not(condition) {
            System.out.println("ERROR " + String.format(messageFormat, args))
            System.out.println()
            Options.printUsage(System.out)
            System.exit(-1)
        }
    }

    static func require(condition: boolean, message: String) {
        if not(condition) {
            System.out.println("ERROR " + message)
            System.out.println()
            Options.printUsage(System.out)
            System.exit(-1)
        }
    }

    static func parseBooleanOption(optionName: String, value: String): boolean {
        switch value.toLowerCase(Locale.ROOT) {
            case "true", "on" -> { return true }
            case "false", "off" -> { return false }
            default -> {
                Options.require(
                    false,
                    "Invalid argument for " + optionName + ": expected true|false|on|off, got " + value
                )
                return false
            }
        }
    }

    static func printUsage(out: PrintStream) {
        out.println("Usage:  jbang Gemma4.java [options]")
        out.println()
        out.println("Options:")
        out.println("  --model, -m <path>            required, path to .gguf file")
        out.println("  --interactive, --chat, -i     run in chat mode")
        out.println("  --instruct                    run in instruct (once) mode, default mode")
        out.println("  --prompt, -p <string>         input prompt")
        out.println("  --suffix <string>             suffix for fill-in-the-middle request")
        out.println("  --system-prompt, -sp <string> system prompt for chat/instruct mode")
        out.println("  --temperature, -temp <float>  temperature in [0,inf], default 1.0")
        out.println("  --top-p <float>               p value in top-p (nucleus) sampling in [0,1] default 0.95")
        out.println("  --seed <long>                 random seed, default System.nanoTime()")
        out.println("  --max-tokens, -n <int>        number of steps to run for < 0 = limited by context length, default " + Gemma4.DEFAULT_MAX_TOKENS)
        out.println("  --stream <boolean>            print tokens during generation; accepts true|false|on|off, default true")
        out.println("  --echo <boolean>              print ALL tokens to stderr; accepts true|false|on|off, default false")
        out.println("  --color <on|off|auto>         colorize thinking output in terminal (default: auto)")
        out.println("  --think <off|on|inline>       off: disable thoughts, on: thoughts to stderr, inline: thoughts to stdout")
        out.println()
        out.println("Interactive commands:")
        out.println("  /quit, /exit                  exit the chat")
        out.println("  /context                      show context token usage")
        out.println()
        out.println("Examples:")
        out.println("  jbang Gemma4.java --model gemma-4-E2B-it-Q8_0.gguf --chat")
        out.println("  jbang Gemma4.java --model gemma-4-E2B-it-Q8_0.gguf --prompt \"Tell me a joke\"")
        out.println("  jbang Gemma4.java --model gemma-4-E2B-it-Q8_0.gguf --chat --system-prompt \"You are a helpful assistant\"")
    }

    static func parseOptions(args: String[]): Options {
        var prompt: String = null
        var suffix: String = null
        var systemPrompt: String = null
        var temperature = 1.0f
        var topp = 0.95f
        var modelPath: Path = null
        var seed = System.nanoTime()
        var maxTokens = Gemma4.DEFAULT_MAX_TOKENS
        var interactive = false
        var stream = true
        var echo = false
        var think = false
        var thinkInline = false
        var colorMode = "auto"

        var i = 0
        while i < args.length {
            var optionName = args[i]
            Options.require(
                optionName.startsWith("-"),
                "Invalid option " + optionName
            )
            if optionName == "--interactive" || optionName == "--chat" || optionName == "-i" {
                interactive = true
            } else if optionName == "--instruct" {
                interactive = false
            } else if optionName == "--help" || optionName == "-h" {
                Options.printUsage(System.out)
                System.exit(0)
            } else {
                var nextArg = ""
                if optionName.contains("=") {
                    let parts = optionName.split("=", 2)
                    optionName = parts[0]
                    nextArg = parts[1]
                } else {
                    Options.require(
                        i + 1 < args.length,
                        "Missing argument for option " + optionName
                    )
                    nextArg = args[i + 1]
                    i = i + 1
                }
                
                if optionName == "--prompt" || optionName == "-p" {
                    prompt = nextArg
                } else if optionName == "--suffix" {
                    suffix = nextArg
                } else if optionName == "--system-prompt" || optionName == "-sp" {
                    systemPrompt = nextArg
                } else if optionName == "--temperature" || optionName == "--temp" {
                    temperature = Float.parseFloat(nextArg)
                } else if optionName == "--top-p" {
                    topp = Float.parseFloat(nextArg)
                } else if optionName == "--model" || optionName == "-m" {
                    modelPath = Path.of(nextArg)
                } else if optionName == "--seed" || optionName == "-s" {
                    seed = Long.parseLong(nextArg)
                } else if optionName == "--max-tokens" || optionName == "-n" {
                    maxTokens = Integer.parseInt(nextArg)
                } else if optionName == "--stream" {
                    stream = Options.parseBooleanOption(optionName, nextArg)
                } else if optionName == "--echo" {
                    echo = Options.parseBooleanOption(optionName, nextArg)
                } else if optionName == "--color" {
                    colorMode = nextArg.toLowerCase(Locale.ROOT)
                } else if optionName == "--think" {
                    let thinkMode = nextArg.toLowerCase(Locale.ROOT)
                    thinkInline = (thinkMode == "inline" || thinkMode == "stdout")
                    if thinkMode == "on" || thinkMode == "true" || thinkMode == "inline" || thinkMode == "stdout" {
                        think = true
                    } else if thinkMode == "off" || thinkMode == "false" {
                        think = false
                    } else {
                        Options.require(
                            false,
                            "Invalid argument for " + optionName + ": expected off|on|inline (or false|true|stdout), got " + nextArg
                        )
                    }
                } else {
                    Options.require(false, "Unknown option: " + optionName)
                }
            }
            i = i + 1
        }
        
        let validColors = List.of("on", "off", "auto")
        Options.require(
            validColors.contains(colorMode),
            "Invalid argument: --color must be one of on|off|auto"
        )
        let color = Gemma4.supportsAnsiColors(colorMode)
        return Options(
            modelPath,
            prompt,
            suffix,
            systemPrompt,
            interactive,
            temperature,
            topp,
            seed,
            maxTokens,
            stream,
            echo,
            think,
            thinkInline,
            color
        )
    }
}

// ==========================================
// Gemma4 Main Logic
// ==========================================

class Gemma4 {
    static let DEFAULT_MAX_TOKENS = 1024

    private static let ANSI_CYAN = "\033[36m"
    private static let ANSI_RESET = "\033[0m"
    private static let ANSI_GREY = "\033[90m"

    static func selectSampler(
        vocabularySize: int,
        temperature: float,
        topp: float,
        rngSeed: long
    ): Sampler {
        if temperature == 0.0f {
            return ArgmaxSampler()
        }
        let rng = RandomGeneratorFactory.getDefault().create(rngSeed)
        var innerSampler: Sampler = null
        if topp <= 0.0f || topp >= 1.0f {
            innerSampler = CategoricalSampler(rng)
        } else {
            innerSampler = ToppSampler(vocabularySize, topp, rng)
        }
        return logits -> {
            let logitsSize = Math.toIntExact(logits.size())
            logits.divideInPlace(0, logitsSize, temperature)
            logits.softmaxInPlace(0, logitsSize)
            return innerSampler.sampleToken(logits)
        }
    }

    private static func plainStreamingPrinter(tokenizer: GemmaTokenizer): IntConsumer {
        return token -> {
            if not(tokenizer.isSpecialToken(token)) {
                System.out.print(tokenizer.decode(List.of(token)))
            }
        }
    }

    private static func onThinkingStart(thoughtOut: PrintStream, ansi: boolean) {
        if ansi {
            thoughtOut.print(Gemma4.ANSI_GREY)
        }
        thoughtOut.println("[Start thinking]")
    }

    private static func onThinkingEnd(
        thoughtOut: PrintStream,
        ansi: boolean,
        emitted: boolean
    ) {
        if emitted {
            thoughtOut.println()
        }
        thoughtOut.println("[End thinking]")
        if ansi {
            thoughtOut.print(Gemma4.ANSI_RESET)
        }
        thoughtOut.println()
    }

    static func supportsAnsiColors(colorMode: String): boolean {
        switch colorMode {
            case "on" -> { return true }
            case "off" -> { return false }
            case "auto" -> {
                if System.console() == null {
                    return false
                }
                let noColor = System.getenv("NO_COLOR")
                if noColor != null {
                    return false
                }
                let term = System.getenv("TERM")
                return term == null || not("dumb".equalsIgnoreCase(term))
            }
            default -> { return false }
        }
    }

    private static func streamingPrinter(
        tokenizer: GemmaTokenizer,
        options: Options
    ): IntConsumer {
        if not(options.stream) {
            return token -> {}
        }

        let channelOpen = tokenizer.getSpecialTokens().get("<|channel>")
        let channelClose = tokenizer.getSpecialTokens().get("<channel|>")
        if channelOpen == null || channelClose == null {
            return Gemma4.plainStreamingPrinter(tokenizer)
        }

        let thinkEnabled = options.think
        let thoughtOut = options.thinkInline ? System.out : System.err
        let ansi = options.colors
        let inChannel = new boolean[1]
        let emitted = new boolean[1]
        inChannel[0] = false
        emitted[0] = false

        return token -> {
            if token == channelOpen {
                if thinkEnabled {
                    Gemma4.onThinkingStart(thoughtOut, ansi)
                }
                inChannel[0] = true
                emitted[0] = false
                return
            }
            if token == channelClose {
                if thinkEnabled {
                    Gemma4.onThinkingEnd(thoughtOut, ansi, emitted[0])
                }
                inChannel[0] = false
                emitted[0] = false
                return
            }
            if not(tokenizer.isSpecialToken(token)) {
                let text = tokenizer.decode(List.of(token))
                if inChannel[0] {
                    if thinkEnabled {
                        thoughtOut.print(text)
                        emitted[0] = true
                    }
                } else {
                    System.out.print(text)
                }
            }
        }
    }

    private static func visibleTokens(
        tokenizer: GemmaTokenizer,
        tokens: List<Integer>,
        think: boolean
    ): List<Integer> {
        return think ? Gemma4.stripThoughtChannelTokens(tokenizer, tokens) : tokens
    }

    private static func stripThoughtChannelTokens(
        tokenizer: GemmaTokenizer,
        tokens: List<Integer>
    ): List<Integer> {
        let channelOpen = tokenizer.getSpecialTokens().get("<|channel>")
        let channelClose = tokenizer.getSpecialTokens().get("<channel|>")
        if channelOpen == null || channelClose == null || tokens.isEmpty() {
            return tokens
        }
        let out = ArrayList<Integer>(tokens.size())
        var inChannel = false
        for tok in tokens {
            if tok == channelOpen {
                inChannel = true
                continue
            }
            if tok == channelClose {
                inChannel = false
                continue
            }
            if not(inChannel) {
                out.add(tok)
            }
        }
        return out
    }

    static func runInteractive(model: Llama, sampler: Sampler, options: Options) {
        var state: State = null
        let chatFormat = GemmaChatFormat(model.tokenizer())
        let conversationTokens = ArrayList<Integer>()
        
        if options.think {
            conversationTokens.addAll(
                chatFormat.encodeSystemThinkingTurn(options.systemPrompt)
            )
        } else if options.systemPrompt != null {
            conversationTokens.addAll(
                chatFormat.encodeMessage(
                    Message(Role.SYSTEM, options.systemPrompt)
                )
            )
        }

        var startPosition = 0
        let scanner = Scanner(System.in)
        while true {
            System.out.print("> ")
            System.out.flush()
            let userText = scanner.nextLine()
            if userText == "/quit" || userText == "/exit" {
                break
            }
            if userText == "/context" {
                System.out.printf(
                    "%d out of %d context tokens used (%d tokens remaining)%n",
                    conversationTokens.size(),
                    options.maxTokens,
                    options.maxTokens - conversationTokens.size()
                )
                continue
            }
            
            if state == null {
                state = model.createNewState()
            }
            
            conversationTokens.addAll(
                chatFormat.encodeMessage(Message(Role.USER, userText))
            )
            conversationTokens.addAll(
                chatFormat.encodeHeader(Message(Role.MODEL, ""))
            )

            let stopTokens = chatFormat.getStopTokens()
            let printer = Gemma4.streamingPrinter(model.tokenizer(), options)
            let responseTokens = Llama.generateTokens(
                model,
                state,
                startPosition,
                conversationTokens.subList(startPosition, conversationTokens.size()),
                stopTokens,
                options.maxTokens,
                sampler,
                options.echo,
                options.colors,
                printer
            )

            var stopToken: Integer = null
            if not(responseTokens.isEmpty()) && stopTokens.contains(responseTokens.getLast()) {
                stopToken = responseTokens.getLast()
                responseTokens.removeLast()
            }

            let visibleResponseTokens = Gemma4.visibleTokens(
                model.tokenizer(),
                responseTokens,
                options.think
            )
            conversationTokens.addAll(responseTokens)
            if stopToken != null {
                conversationTokens.add(stopToken)
                if stopToken == chatFormat.endOfTurn {
                    conversationTokens.addAll(model.tokenizer().encode("\n"))
                }
            }
            
            startPosition = conversationTokens.size()
            if not(options.stream) {
                let responseText = model.tokenizer().decode(visibleResponseTokens)
                System.out.println(responseText)
            }
            if stopToken == null {
                System.err.println("Ran out of context length...")
                break
            }
        }
    }

    static func runInstructOnce(model: Llama, sampler: Sampler, options: Options) {
        let state = model.createNewState()
        let chatFormat = GemmaChatFormat(model.tokenizer())
        let promptTokens = ArrayList<Integer>()

        if options.suffix != null {
            promptTokens.addAll(
                chatFormat.encodeFillInTheMiddle(options.prompt, options.suffix)
            )
        } else {
            if options.think {
                promptTokens.addAll(
                    chatFormat.encodeSystemThinkingTurn(options.systemPrompt)
                )
            } else if options.systemPrompt != null {
                promptTokens.addAll(
                    chatFormat.encodeMessage(
                        Message(Role.SYSTEM, options.systemPrompt)
                    )
                )
            }
            promptTokens.addAll(
                chatFormat.encodeMessage(
                    Message(Role.USER, options.prompt)
                )
            )
            promptTokens.addAll(
                chatFormat.encodeHeader(
                    Message(Role.MODEL, "")
                )
            )
        }

        let stopTokens = chatFormat.getStopTokens()
        let printer = Gemma4.streamingPrinter(model.tokenizer(), options)
        let responseTokens = Llama.generateTokens(
            model,
            state,
            0,
            promptTokens,
            stopTokens,
            options.maxTokens,
            sampler,
            options.echo,
            options.colors,
            printer
        )

        if not(responseTokens.isEmpty()) && stopTokens.contains(responseTokens.getLast()) {
            responseTokens.removeLast()
        }

        let visibleResponseTokens = Gemma4.visibleTokens(
            model.tokenizer(),
            responseTokens,
            options.think
        )
        if not(options.stream) {
            let responseText = model.tokenizer().decode(visibleResponseTokens)
            System.out.println(responseText)
        }
    }

    static func main(args: String[]) {
        let options = Options.parseOptions(args)
        var model = AOT.tryUsePreLoaded(
            options.modelPath,
            options.maxTokens
        )
        if model == null {
            model = ModelLoader.loadModel(
                options.modelPath,
                options.maxTokens
            )
        }
        let sampler = Gemma4.selectSampler(
            model.configuration().vocabularySize,
            options.temperature,
            options.topp,
            options.seed
        )
        if options.interactive {
            Gemma4.runInteractive(model, sampler, options)
        } else {
            Gemma4.runInstructOnce(model, sampler, options)
        }
    }
}

// Extension to Llama to support generateTokens
func Llama.generateTokens(
    model: Llama,
    state: State,
    startPosition: int,
    promptTokens: List<Integer>,
    stopTokens: Set<Integer>,
    maxTokens: int,
    sampler: Sampler,
    echo: boolean,
    color: boolean,
    onTokenGenerated: IntConsumer
): List<Integer> {
    let startNanos = System.nanoTime()
    var startGen = 0L
    var limitTokens = maxTokens
    if limitTokens < 0 || model.configuration().contextLength < limitTokens {
        limitTokens = model.configuration().contextLength
    }
    let generatedTokens = ArrayList<Integer>(limitTokens)
    var token = state.latestToken
    var nextToken = 0
    var promptIndex = 0
    
    var position = startPosition
    while position < limitTokens {
        Gemma4_Runner.forward(model, state, token, position)
        if promptIndex < promptTokens.size() {
            nextToken = promptTokens.get(promptIndex)
            promptIndex = promptIndex + 1
            if echo {
                System.err.print(
                    GemmaTokenizer.replaceControlCharacters(
                        model.tokenizer().decode(List.of(nextToken))
                    )
                )
            }
            if promptIndex >= promptTokens.size() {
                startGen = System.nanoTime()
            }
        } else {
            nextToken = sampler.sampleToken(state.logits)
            if echo {
                System.err.print(
                    GemmaTokenizer.replaceControlCharacters(
                        model.tokenizer().decode(List.of(nextToken))
                    )
                )
            }
            generatedTokens.add(nextToken)
            if onTokenGenerated != null {
                onTokenGenerated.accept(nextToken)
            }
            if stopTokens.contains(nextToken) {
                break
            }
        }
        state.latestToken = nextToken
        token = nextToken
        position = position + 1
    }

    let elapsedNanos = System.nanoTime() - startNanos
    let promptNanos = startGen - startNanos
    let genNanos = elapsedNanos - startGen
    let timingPrefix = color ? Gemma4.ANSI_CYAN : ""
    let timingSuffix = color ? Gemma4.ANSI_RESET : ""
    System.err.printf(
        "%n%scontext: %d/%d prompt: %.2f tokens/s (%d) generation: %.2f tokens/s (%d)%s%n",
        [
            timingPrefix,
            startPosition + promptIndex + generatedTokens.size(),
            model.configuration().contextLength,
            promptTokens.size() / ((double) promptNanos / 1000000000.0),
            promptTokens.size(),
            generatedTokens.size() / ((double) genNanos / 1000000000.0),
            generatedTokens.size(),
            timingSuffix
        ]
    )

    return generatedTokens
}

// Wrapper runner logic for forward passes
class Gemma4_Runner {
    static func gelu(x: float): float {
        return (float) (0.5 * (double) x * (1.0 + Math.tanh(Math.sqrt(2.0 / Math.PI) * ((double) x + 0.044715 * Math.pow((double) x, 3.0)))))
    }

    static func rmsnorm(
        out: FloatTensor,
        x: FloatTensor,
        weight: FloatBuffer,
        size: int,
        rmsNormEps: float
    ) {
        var ss = x.reduce(0, size, 0.0f, (acc, xi) -> acc + xi * xi)
        ss = ss / (float) size
        ss = ss + rmsNormEps
        ss = (float) (1.0 / Math.sqrt((double) ss))
        let finalss = ss
        out.mapWithIndexInPlace(
            0,
            size,
            (value, index) -> weight.get(index) * (finalss * x.getFloat((long) index))
        )
    }

    static func rmsnorm(
        out: FloatTensor,
        outOffset: int,
        x: FloatTensor,
        xOffset: int,
        weight: FloatBuffer,
        size: int,
        rmsNormEps: float
    ) {
        var ss = 0.0f
        var i = 0
        while i < size {
            let xi = x.getFloat((long) (xOffset + i))
            ss = ss + xi * xi
            i = i + 1
        }
        ss = ss / (float) size
        ss = ss + rmsNormEps
        ss = (float) (1.0 / Math.sqrt((double) ss))
        i = 0
        while i < size {
            out.setFloat(
                outOffset + i,
                weight.get(i) * ss * x.getFloat((long) (xOffset + i))
            )
            i = i + 1
        }
    }

    static func rmsnormNoWeight(
        out: FloatTensor,
        outOffset: int,
        x: FloatTensor,
        xOffset: int,
        size: int,
        rmsNormEps: float
    ) {
        var ss = 0.0f
        var i = 0
        while i < size {
            let xi = x.getFloat((long) (xOffset + i))
            ss = ss + xi * xi
            i = i + 1
        }
        ss = ss / (float) size
        ss = ss + rmsNormEps
        ss = (float) (1.0 / Math.sqrt((double) ss))
        i = 0
        while i < size {
            out.setFloat(outOffset + i, ss * x.getFloat((long) (xOffset + i)))
            i = i + 1
        }
    }

    static func forward(
        model: Llama,
        state: State,
        token: int,
        position: int
    ): FloatTensor {
        let config = model.configuration()
        let weights = model.weights()
        let dim = config.embeddingLength
        let sqrtDim = (float) Math.sqrt((double) dim)

        weights.token_embedding_table.copyTo(token * dim, state.x, 0, dim)
        state.x.mapInPlace(v -> v * sqrtDim)

        let plDim = config.embeddingLengthPerLayer
        let plTotal = plDim * config.numberOfLayers
        if plDim > 0 && weights.perLayerTokenEmbd != null {
            let sqrtPlDim = (float) Math.sqrt((double) plDim)
            let projScale = (float) (1.0 / Math.sqrt((double) dim))
            let inputScale = (float) (1.0 / Math.sqrt(2.0))

            weights.perLayerModelProj.matmul(
                state.x,
                state.perLayerInputs,
                plTotal,
                dim
            )
            state.perLayerInputs.mapInPlace(0, plTotal, v -> v * projScale)
            var l = 0
            while l < config.numberOfLayers {
                Gemma4_Runner.rmsnorm(
                    state.perLayerInputs,
                    l * plDim,
                    state.perLayerInputs,
                    l * plDim,
                    weights.perLayerProjNorm,
                    plDim,
                    config.rmsNormEps
                )
                l = l + 1
            }

            let tokEmbOffset = (long) token * (long) plTotal
            var i = 0
            while i < plTotal {
                let tokEmb = weights.perLayerTokenEmbd.getFloat(tokEmbOffset + (long) i) * sqrtPlDim
                state.perLayerInputs.setFloat(
                    i,
                    state.perLayerInputs.getFloat((long) i) + tokEmb
                )
                i = i + 1
            }

            state.perLayerInputs.mapInPlace(0, plTotal, v -> v * inputScale)
        }

        var l = 0
        while l < config.numberOfLayers {
            let layerIsSWA = config.isSWA[l]
            let headSize = config.headSize(l)
            let halfHead = headSize / 2
            let queryDim = config.queryDim(l)
            let kvDim = config.kvDim(l)
            let hiddenDim = config.feedForwardLength[l]

            Gemma4_Runner.rmsnorm(
                state.xb,
                state.x,
                weights.rms_att_weight[l],
                dim,
                config.rmsNormEps
            )

            weights.wq[l].matmul(state.xb, state.q, queryDim, dim)
            var h = 0
            while h < config.numberOfHeads {
                Gemma4_Runner.rmsnorm(
                    state.q,
                    h * headSize,
                    state.q,
                    h * headSize,
                    weights.attn_q_norm[l],
                    headSize,
                    config.rmsNormEps
                )
                h = h + 1
            }

            let freqsReal = layerIsSWA ? weights.freq_cis_real_swa : weights.freq_cis_real_full
            let freqsImag = layerIsSWA ? weights.freq_cis_imag_swa : weights.freq_cis_imag_full
            h = 0
            while h < config.numberOfHeads {
                let poffset = h * headSize
                var i0 = 0
                while i0 < headSize {
                    let ic = i0 / 2
                    let fcr = freqsReal.get(position * halfHead + ic)
                    let fci = freqsImag.get(position * halfHead + ic)
                    let v0 = state.q.getFloat((long) (poffset + ic))
                    let v1 = state.q.getFloat((long) (poffset + ic + halfHead))
                    state.q.setFloat(poffset + ic, v0 * fcr - v1 * fci)
                    state.q.setFloat(poffset + ic + halfHead, v0 * fci + v1 * fcr)
                    i0 = i0 + 2
                }
                h = h + 1
            }

            let kvLayer = config.kvSourceLayer(l)
            let nKvHeads = config.numberOfKeyValueHeads(l)
            let kvMul = config.numberOfHeads / nKvHeads
            if config.hasKv(l) {
                weights.wk[l].matmul(state.xb, state.k, kvDim, dim)
                if weights.wv[l] != null {
                    weights.wv[l].matmul(state.xb, state.v, kvDim, dim)
                } else {
                    state.k.copyTo(0, state.v, 0, kvDim)
                }

                h = 0
                while h < nKvHeads {
                    Gemma4_Runner.rmsnorm(
                        state.k,
                        h * headSize,
                        state.k,
                        h * headSize,
                        weights.attn_k_norm[l],
                        headSize,
                        config.rmsNormEps
                    )
                    Gemma4_Runner.rmsnormNoWeight(
                        state.v,
                        h * headSize,
                        state.v,
                        h * headSize,
                        headSize,
                        config.rmsNormEps
                    )
                    h = h + 1
                }

                h = 0
                while h < nKvHeads {
                    let poffset = h * headSize
                    var i0 = 0
                    while i0 < headSize {
                        let ic = i0 / 2
                        let fcr = freqsReal.get(position * halfHead + ic)
                        let fci = freqsImag.get(position * halfHead + ic)
                        let v0 = state.k.getFloat((long) (poffset + ic))
                        let v1 = state.k.getFloat((long) (poffset + ic + halfHead))
                        state.k.setFloat(poffset + ic, v0 * fcr - v1 * fci)
                        state.k.setFloat(poffset + ic + halfHead, v0 * fci + v1 * fcr)
                        i0 = i0 + 2
                    }
                    h = h + 1
                }

                let kvPos = config.kvCacheIndex(l, position)
                state.k.copyTo(0, state.keyCache[kvLayer], kvPos * kvDim, kvDim)
                state.v.copyTo(0, state.valueCache[kvLayer], kvPos * kvDim, kvDim)
            }

            let attStart = layerIsSWA ? Math.max(0, position - config.slidingWindow + 1) : 0
            let finalKvLayer = kvLayer
            let finalKvDim = kvDim
            let finalAttStart = attStart
            let finalLayer = l

            Parallel.parallelFor(0, config.numberOfHeads, headIdx -> {
                let qOffset = headIdx * headSize
                let attOffset = headIdx * config.contextLength
                let kvHeadOffset = (headIdx / kvMul) * headSize
                var t = finalAttStart
                while t <= position {
                    let keyCacheOffset = config.kvCacheIndex(finalLayer, t) * finalKvDim + kvHeadOffset
                    let score = state.q.dot(
                        qOffset,
                        state.keyCache[finalKvLayer],
                        keyCacheOffset,
                        headSize
                    )
                    state.att.setFloat(attOffset + t, score)
                    t = t + 1
                }

                state.att.softmaxInPlace(
                    attOffset + finalAttStart,
                    position - finalAttStart + 1
                )
                let xbOffset = headIdx * headSize
                state.xb_k.fillInPlace(xbOffset, headSize, 0.0f)
                t = finalAttStart
                while t <= position {
                    let vOffset = config.kvCacheIndex(finalLayer, t) * finalKvDim + kvHeadOffset
                    let a = state.att.getFloat((long) (attOffset + t))
                    state.xb_k.saxpyInPlace(
                        xbOffset,
                        state.valueCache[finalKvLayer],
                        vOffset,
                        headSize,
                        a
                    )
                    t = t + 1
                }
            })

            weights.wo[l].matmul(state.xb_k, state.xb2, dim, queryDim)
            Gemma4_Runner.rmsnorm(
                state.xb2,
                state.xb2,
                weights.post_attention_norm[l],
                dim,
                config.rmsNormEps
            )
            state.x.addInPlace(state.xb2)

            // FFN
            let isMoELayer = config.isMoE() && weights.ffnGateInp[l] != null
            if isMoELayer {
                Gemma4_Runner.rmsnorm(
                    state.xb,
                    state.x,
                    weights.rms_ffn_weight[l],
                    dim,
                    config.rmsNormEps
                )
                weights.w1[l].matmul(state.xb, state.hb, hiddenDim, dim)
                weights.w3[l].matmul(state.xb, state.hb2, hiddenDim, dim)
                state.hb.mapInPlace(0, hiddenDim, val -> Gemma4_Runner.gelu(val))
                state.hb.multiplyInPlace(0, state.hb2, 0, hiddenDim)
                weights.w2[l].matmul(state.hb, state.xb, dim, hiddenDim)
                Gemma4_Runner.rmsnorm(
                    state.xb,
                    state.xb,
                    weights.ffnPostNorm1[l],
                    dim,
                    config.rmsNormEps
                )

                Gemma4_Runner.rmsnorm(
                    state.moeInput,
                    state.x,
                    weights.preFfwNorm2[l],
                    dim,
                    config.rmsNormEps
                )

                var ss = state.x.reduce(0, dim, 0.0f, (acc, xi) -> acc + xi * xi)
                ss = ss / (float) dim
                ss = ss + config.rmsNormEps
                let rmsScale = (float) (1.0 / Math.sqrt((double) ss)) / (float) Math.sqrt((double) dim)
                var i = 0
                while i < dim {
                    state.xb2.setFloat(
                        i,
                        state.x.getFloat((long) i) *
                        rmsScale *
                        weights.ffnGateInpScale[l].get(i)
                    )
                    i = i + 1
                }
                
                weights.ffnGateInp[l].matmul(
                    state.xb2,
                    state.routerLogits,
                    config.expertCount,
                    dim
                )

                state.routerLogits.softmaxInPlace(0, config.expertCount)

                let nExperts = config.expertCount
                let topK = config.expertUsedCount
                let topExperts = new int[topK]
                let topProbs = new float[topK]
                var ki = 0
                while ki < topK {
                    var bestIdx = 0
                    var bestVal = Float.NEGATIVE_INFINITY
                    var ei = 0
                    while ei < nExperts {
                        let val = state.routerLogits.getFloat((long) ei)
                        if val > bestVal {
                            bestVal = val
                            bestIdx = ei
                        }
                        ei = ei + 1
                    }
                    topExperts[ki] = bestIdx
                    topProbs[ki] = bestVal
                    state.routerLogits.setFloat(bestIdx, Float.NEGATIVE_INFINITY)
                    ki = ki + 1
                }

                let expertFF = config.expertFeedForwardLength
                let gateUpDim = 2 * expertFF
                state.moeOutput.fillInPlace(0, dim, 0.0f)

                ki = 0
                while ki < topK {
                    let expertIdx = topExperts[ki]
                    let prob = topProbs[ki]
                    let downScale = weights.ffnDownExpsScale[l].get(expertIdx)
                    let gateUpOffset = expertIdx * gateUpDim * dim

                    weights.ffnGateUpExps[l].matmul(
                        state.moeInput,
                        state.expertGateUp,
                        gateUpDim,
                        dim,
                        gateUpOffset
                    )

                    state.expertGateUp.mapInPlace(0, expertFF, val -> Gemma4_Runner.gelu(val))
                    i = 0
                    while i < expertFF {
                        state.expertGateUp.setFloat(
                            i,
                            state.expertGateUp.getFloat((long) i) *
                            state.expertGateUp.getFloat((long) (expertFF + i))
                        )
                        i = i + 1
                    }

                    let downOffset = expertIdx * dim * expertFF
                    weights.ffnDownExps[l].matmul(
                        state.expertGateUp,
                        state.expertDown,
                        dim,
                        expertFF,
                        downOffset
                    )

                    let finalWeight = prob * downScale
                    state.moeOutput.saxpyInPlace(0, state.expertDown, 0, dim, finalWeight)
                    ki = ki + 1
                }

                Gemma4_Runner.rmsnorm(
                    state.moeOutput,
                    state.moeOutput,
                    weights.ffnPostNorm2[l],
                    dim,
                    config.rmsNormEps
                )

                state.xb.addInPlace(0, state.moeOutput, 0, dim)

                Gemma4_Runner.rmsnorm(
                    state.xb,
                    state.xb,
                    weights.post_ffw_norm[l],
                    dim,
                    config.rmsNormEps
                )
                state.x.addInPlace(state.xb)
            } else {
                Gemma4_Runner.rmsnorm(
                    state.xb,
                    state.x,
                    weights.rms_ffn_weight[l],
                    dim,
                    config.rmsNormEps
                )
                weights.w1[l].matmul(state.xb, state.hb, hiddenDim, dim)
                weights.w3[l].matmul(state.xb, state.hb2, hiddenDim, dim)
                state.hb.mapInPlace(0, hiddenDim, val -> Gemma4_Runner.gelu(val))
                state.hb.multiplyInPlace(0, state.hb2, 0, hiddenDim)
                weights.w2[l].matmul(state.hb, state.xb, dim, hiddenDim)
                Gemma4_Runner.rmsnorm(
                    state.xb,
                    state.xb,
                    weights.post_ffw_norm[l],
                    dim,
                    config.rmsNormEps
                )
                state.x.addInPlace(state.xb)
            }

            if plDim > 0 && weights.perLayerInpGate != null {
                weights.perLayerInpGate[l].matmul(
                    state.x,
                    state.plGate,
                    plDim,
                    dim
                )
                state.plGate.mapInPlace(0, plDim, val -> Gemma4_Runner.gelu(val))
                let plOffset = l * plDim
                i = 0
                while i < plDim {
                    state.plGate.setFloat(
                        i,
                        state.plGate.getFloat((long) i) *
                        state.perLayerInputs.getFloat((long) (plOffset + i))
                    )
                    i = i + 1
                }
                weights.perLayerProj[l].matmul(
                    state.plGate,
                    state.plProj,
                    dim,
                    plDim
                )
                Gemma4_Runner.rmsnorm(
                    state.plProj,
                    state.plProj,
                    weights.perLayerPostNorm[l],
                    dim,
                    config.rmsNormEps
                )
                state.x.addInPlace(state.plProj)
            }

            let scale = weights.layerOutputScale[l]
            if scale != 1.0f {
                state.x.mapInPlace(0, dim, v -> v * scale)
            }
            
            l = l + 1
        }

        Gemma4_Runner.rmsnorm(
            state.x,
            state.x,
            weights.rms_final_weight,
            dim,
            config.rmsNormEps
        )
        weights.wcls.matmul(state.x, state.logits, config.vocabularySize, dim)
        if config.logitSoftcapping > 0.0f {
            let cap = config.logitSoftcapping
            state.logits.mapInPlace(v -> cap * (float) Math.tanh((double) (v / cap)))
        }
        return state.logits
    }
}
