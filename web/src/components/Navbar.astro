---
const navLinks = [
  { href: '/#features', label: 'Features' },
  { href: '/#syntax', label: 'Syntax' },
  { href: '/docs', label: 'Docs' },
  { href: '/#roadmap', label: 'Roadmap' },
  { href: 'https://github.com/alex-cova/affogato', label: 'GitHub', external: true },
];
---

<header id="navbar" class="fixed top-0 left-0 right-0 z-50 transition-[background,backdrop-filter] duration-300">
  <nav class="max-w-7xl mx-auto px-6 h-16 flex items-center justify-between" aria-label="Main">
    <!-- Logo -->
    <a href="/" class="flex items-center gap-2 group" id="nav-logo">
      <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-[var(--color-amber)] to-[var(--color-crema)] flex items-center justify-center text-white font-black text-sm transition-transform group-hover:scale-110">
        ☕
      </div>
      <span class="font-bold text-lg tracking-tight text-gradient">Affogato</span>
    </a>

    <!-- Desktop links -->
    <div class="hidden md:flex items-center gap-8">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="nav-link"
          target={link.external ? '_blank' : undefined}
          rel={link.external ? 'noopener noreferrer' : undefined}
        >
          {link.label}
          {link.external && (
            <svg class="inline w-3 h-3 ml-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          )}
        </a>
      ))}
    </div>

    <!-- CTA -->
    <div class="hidden md:flex items-center gap-3">
      <a href="/docs" class="btn-primary text-sm py-2 px-4">
        Get Started
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
    </div>

    <!-- Hamburger -->
    <button
      id="hamburger"
      type="button"
      class="md:hidden flex flex-col gap-1.5 p-2 rounded-lg hover:bg-white/5 transition-colors"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <span class="w-5 h-0.5 bg-[var(--color-text)] block"></span>
      <span class="w-5 h-0.5 bg-[var(--color-text)] block"></span>
      <span class="w-5 h-0.5 bg-[var(--color-text)] block"></span>
    </button>
  </nav>
</header>

<!-- Mobile menu -->
<div
  id="mobile-menu"
  class="mobile-menu"
  role="dialog"
  aria-modal="true"
  aria-label="Navigation menu"
>
  <button
    id="close-menu"
    type="button"
    class="absolute top-5 right-6 text-[var(--color-muted)] hover:text-white text-3xl leading-none"
    aria-label="Close menu"
  >
    ×
  </button>
  <div class="flex items-center gap-2 mb-8">
    <span class="text-2xl" aria-hidden="true">☕</span>
    <span class="font-bold text-2xl text-gradient">Affogato</span>
  </div>
  {navLinks.map((link) => (
    <a
      href={link.href}
      class="text-xl font-medium text-[var(--color-text)] hover:text-[var(--color-amber)] transition-colors"
      target={link.external ? '_blank' : undefined}
      rel={link.external ? 'noopener noreferrer' : undefined}
    >
      {link.label}
    </a>
  ))}
  <a href="/docs" class="btn-primary mt-4">Get Started →</a>
</div>
