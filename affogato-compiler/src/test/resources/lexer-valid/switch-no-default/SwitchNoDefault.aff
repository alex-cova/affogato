package dev.affogato.lexer.valid

// Affogato does not require a default branch on switch statements over non-enum types.
// This fixture documents that the compiler accepts such code without any diagnostic.
class SwitchNoDefault {
    run(): String {
        let score: int = 85
        switch score {
            case 90, 91, 92, 93, 94, 95, 96, 97, 98, 99, 100 -> return "A"
            case 80, 81, 82, 83, 84, 85, 86, 87, 88, 89 -> return "B"
            case 70, 71, 72, 73, 74, 75, 76, 77, 78, 79 -> return "C"
        }
        return "F"
    }
}
