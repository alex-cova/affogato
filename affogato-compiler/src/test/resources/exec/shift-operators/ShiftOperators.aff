package dev.affogato.exec

class ShiftOperators {
    static func run() {
        let x = 1 << 4
        let y = 256 >> 2
        let z = (-1) >>> 28
        let w = x << 2
        let big = 1L << 40
        println(x)
        println(y)
        println(z)
        println(w)
        println(big)
    }
}
