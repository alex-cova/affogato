---
---

<footer class="relative border-t border-[var(--color-border)] mt-24">
  <div class="max-w-7xl mx-auto px-6 py-16">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-12 mb-12">
      <!-- Brand -->
      <div class="md:col-span-1">
        <div class="flex items-center gap-2 mb-4">
          <span class="text-xl">☕</span>
          <span class="font-bold text-lg text-gradient">Affogato</span>
        </div>
        <p class="text-sm text-[var(--color-muted)] leading-relaxed">
          A rich, smooth JVM language that transpiles to Java 21. Crafted for expressive, type-safe code.
        </p>
      </div>

      <!-- Language -->
      <div>
        <h4 class="text-sm font-semibold text-[var(--color-text)] mb-4 uppercase tracking-widest">Language</h4>
        <ul class="space-y-2">
          <li><a href="/docs#syntax">Syntax Guide</a></li>
          <li><a href="/docs#nullability">Nullability</a></li>
          <li><a href="/docs#java-interop">Java Interop</a></li>
          <li><a href="/docs#diagnostics">Diagnostics</a></li>
        </ul>
      </div>

      <!-- Tools -->
      <div>
        <h4 class="text-sm font-semibold text-[var(--color-text)] mb-4 uppercase tracking-widest">Tools</h4>
        <ul class="space-y-2">
          <li><a href="/docs#gradle">Gradle Plugin</a></li>
          <li><a href="/docs#intellij">IntelliJ Plugin</a></li>
          <li><a href="/docs#getting-started">CLI Compiler</a></li>
          <li><a href="/#roadmap">Roadmap</a></li>
        </ul>
      </div>

      <!-- Community -->
      <div>
        <h4 class="text-sm font-semibold text-[var(--color-text)] mb-4 uppercase tracking-widest">Project</h4>
        <ul class="space-y-2">
          <li><a href="https://github.com/alex-cova/affogato" target="_blank" rel="noopener">GitHub</a></li>
          <li><a href="https://github.com/alex-cova/affogato/issues" target="_blank" rel="noopener">Issues</a></li>
          <li><a href="https://github.com/alex-cova/affogato/blob/main/README.md" target="_blank" rel="noopener">README</a></li>
          <li><a href="https://github.com/alex-cova/affogato/blob/main/AFFOGATO_ROADMAP.md" target="_blank" rel="noopener">Roadmap</a></li>
        </ul>
      </div>
    </div>

    <div class="border-t border-[var(--color-border)] pt-8 flex flex-col md:flex-row items-center justify-between gap-4">
      <p class="text-sm text-[var(--color-muted)]">
        © 2026 Affogato Language Project. Built with ☕ and passion.
      </p>
      <div class="flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-[var(--color-amber)] animate-pulse inline-block"></span>
        <span class="text-xs text-[var(--color-muted)]">Experimental — JVM target: Java 21</span>
      </div>
    </div>
  </div>
</footer>
