package dev.affogato.parser.valid

class BitwiseShiftPrecedence {
    // Validates that the parser accepts complex chains of bitwise, shift, and cast
    // operators without syntax errors and in the expected associativity.
    // a << b >> c   (left-to-right shift chain)
    // x & y | z    (bitwise AND then OR)
    // (a as int) >> 2 & 0xFF   (cast combined with shift and mask)
    check(a: int, b: int, c: int, x: int, y: int, z: int): int {
        let shifted = a << b >> c
        let bits = x & y | z
        let masked = (a as int) >> 2 & 0xFF
        let full = ((a << b) as int) >> c & (x | y ^ z)
        return shifted + bits + masked + full
    }
}
