package dev.affogato.golden

import java.util.Arrays
import java.util.List

class JavaVarargs {
    run(): String {
        let formatted = String.format("%s-%s-%d", "af", "fogato", 2)
        let values = List.of("one", "two")
        let arrayList = Arrays.asList("three", "four")
        let valuesSize = values.size()
        let arrayListSize = arrayList.size()
        return formatted + ":" + valuesSize + ":" + arrayListSize
    }
}
