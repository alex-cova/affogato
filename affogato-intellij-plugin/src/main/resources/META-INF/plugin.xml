<idea-plugin>
    <id>dev.affogato.intellij</id>
    <name>Affogato</name>
    <vendor email="dev@affogato.local">Affogato</vendor>
    <description>Language support scaffold for Affogato source files.</description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.java</depends>
    <depends>com.intellij.gradle</depends>

    <extensions defaultExtensionNs="com.intellij">
        <fileType
                name="Affogato"
                language="Affogato"
                implementationClass="dev.affogato.intellij.AffogatoFileType"
                fieldName="INSTANCE"
                extensions="aff"/>
        <lang.parserDefinition
                language="Affogato"
                implementationClass="dev.affogato.intellij.parser.AffogatoParserDefinition"/>
        <lang.syntaxHighlighterFactory
                language="Affogato"
                implementationClass="dev.affogato.intellij.highlighting.AffogatoSyntaxHighlighterFactory"/>
        <lang.findUsagesProvider
                language="Affogato"
                implementationClass="dev.affogato.intellij.findusages.AffogatoFindUsagesProvider"/>
        <lang.formatter
                language="Affogato"
                implementationClass="dev.affogato.intellij.formatter.AffogatoFormattingModelBuilder"/>
        <externalAnnotator
                language="Affogato"
                implementationClass="dev.affogato.intellij.annotator.AffogatoExternalAnnotator"/>
        <annotator
                language="Affogato"
                implementationClass="dev.affogato.intellij.highlighting.AffogatoHighlightAnnotator"/>
        <colorSettingsPage
                implementation="dev.affogato.intellij.highlighting.AffogatoColorSettingsPage"/>
        <lang.commenter
                language="Affogato"
                implementationClass="dev.affogato.intellij.AffogatoCommenter"/>
        <lang.braceMatcher
                language="Affogato"
                implementationClass="dev.affogato.intellij.AffogatoBraceMatcher"/>
        <runLineMarkerContributor
                language="Affogato"
                implementationClass="dev.affogato.intellij.run.AffogatoRunLineMarkerContributor"/>
        <runConfigurationProducer
                implementation="dev.affogato.intellij.run.AffogatoRunConfigurationProducer"/>
    </extensions>
</idea-plugin>
